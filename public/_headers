# Netlify custom headers — cache & security
# Docs: https://docs.netlify.com/routing/headers/

# Fonts (Google Fonts — proxied via Netlify, immutable)
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Hashed assets (JS, CSS, images — fingerprinted by Astro)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Static images (public/ folder, no hash)
/og-default.png
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800

# Sitemap & robots
/sitemap-index.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600

# HTML pages (short cache — Netlify CDN handles conditional requests)
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
