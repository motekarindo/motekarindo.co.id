---
import { site } from "@/lib/site.data";

interface Props {
  pageTitle?: string;
}

const { pageTitle } = Astro.props;

const org = {
  "@context": "https://schema.org",
  "@type": "ProfessionalService",
  name: "Motekar Teknologi Indonesia",
  url: "https://motekarindo.co.id",
  logo: "https://motekarindo.co.id/favicon.svg",
  description:
    "Jasa IT profesional: konsultasi, web development, DevOps, QA, instalasi aplikasi, dan maintenance server. Terukur, terdokumentasi, bisa dirawat.",
  telephone: `${site.whatsApp}`,
  email: `${site.email}`,
  address: {
    "@type": "PostalAddress",
    addressCountry: "ID",
  },
  sameAs: [`https://wa.me/${site.whatsApp}`],
  areaServed: {
    "@type": "Country",
    name: "Indonesia",
  },
  knowsAbout: [
    "Konsultan IT",
    "IT Consulting",
    "Web Development",
    "DevOps",
    "Quality Assurance",
    "Server Maintenance",
    "Instalasi Aplikasi",
    "OJS",
    "ePrints",
    "ERP Percetakan Digital",
  ],
};

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Motekar Teknologi Indonesia",
  url: "https://motekarindo.co.id",
  inLanguage: "id",
  description:
    "Jasa IT profesional: konsultasi, web development, DevOps, QA, instalasi aplikasi, dan maintenance server.",
};

const breadcrumbs = (items: { name: string; url: string }[]) => ({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: item.name,
    item: item.url,
  })),
});

function getSchema(type: string, data: Record<string, any>) {
  switch (type) {
    case "Organization":
      return JSON.stringify(org);
    case "WebSite":
      return JSON.stringify({ "@graph": [org, website] });
    case "Service":
      return JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Service",
        provider: { "@type": "ProfessionalService", name: "Motekar Teknologi Indonesia", url: "https://motekarindo.co.id" },
        ...data,
      });
    case "Product":
      return JSON.stringify({
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        applicationCategory: "BusinessApplication",
        operatingSystem: "Web",
        offers: { "@type": "Offer", availability: "https://schema.org/InStock" },
        ...data,
      });
    case "Article":
      return JSON.stringify({
        "@context": "https://schema.org",
        "@type": "Article",
        ...data,
      });
    default:
      return "";
  }
}

// Build schema per page type
const path = Astro.url.pathname;

// Default: homepage = full org + website + breadcrumbs
let schema: string;

if (path === "/") {
  schema = JSON.stringify({
    "@graph": [
      org,
      website,
      breadcrumbs([{ name: "Home", url: "https://motekarindo.co.id" }]),
    ],
  });
} else if (path === "/layanan") {
  schema = JSON.stringify({
    "@graph": [
      org,
      website,
      breadcrumbs([
        { name: "Home", url: "https://motekarindo.co.id" },
        { name: "Layanan", url: "https://motekarindo.co.id/layanan" },
      ]),
    ],
  });
} else if (path.startsWith("/layanan/")) {
  const slug = path.replace("/layanan/", "").replace(/\/$/, "");
  const name = pageTitle || slug;
  schema = JSON.stringify({
    "@graph": [
      org,
      website,
      breadcrumbs([
        { name: "Home", url: "https://motekarindo.co.id" },
        { name: "Layanan", url: "https://motekarindo.co.id/layanan" },
        { name, url: `https://motekarindo.co.id${path}` },
      ]),
    ],
  });
} else if (path === "/solusi") {
  schema = JSON.stringify({
    "@graph": [
      org,
      website,
      breadcrumbs([
        { name: "Home", url: "https://motekarindo.co.id" },
        { name: "Solusi", url: "https://motekarindo.co.id/solusi" },
      ]),
    ],
  });
} else if (path === "/produk") {
  schema = JSON.stringify({
    "@graph": [
      org,
      website,
      breadcrumbs([
        { name: "Home", url: "https://motekarindo.co.id" },
        { name: "Produk", url: "https://motekarindo.co.id/produk" },
      ]),
    ],
  });
} else if (path.startsWith("/produk/")) {
  const slug = path.replace("/produk/", "").replace(/\/$/, "");
  const name = pageTitle || slug;
  schema = JSON.stringify({
    "@graph": [
      org,
      website,
      breadcrumbs([
        { name: "Home", url: "https://motekarindo.co.id" },
        { name: "Produk", url: "https://motekarindo.co.id/produk" },
        { name, url: `https://motekarindo.co.id${path}` },
      ]),
    ],
  });
} else if (path === "/portofolio") {
  schema = JSON.stringify({
    "@graph": [
      org,
      website,
      breadcrumbs([
        { name: "Home", url: "https://motekarindo.co.id" },
        { name: "Portofolio", url: "https://motekarindo.co.id/portofolio" },
      ]),
    ],
  });
} else if (path.startsWith("/portofolio/")) {
  const slug = path.replace("/portofolio/", "").replace(/\/$/, "");
  const name = pageTitle || slug;
  schema = JSON.stringify({
    "@graph": [
      org,
      website,
      breadcrumbs([
        { name: "Home", url: "https://motekarindo.co.id" },
        { name: "Portofolio", url: "https://motekarindo.co.id/portofolio" },
        { name, url: `https://motekarindo.co.id${path}` },
      ]),
    ],
  });
} else if (path === "/tentang") {
  schema = JSON.stringify({
    "@graph": [
      org,
      website,
      breadcrumbs([
        { name: "Home", url: "https://motekarindo.co.id" },
        { name: "Tentang", url: "https://motekarindo.co.id/tentang" },
      ]),
    ],
  });
} else if (path === "/kontak") {
  schema = JSON.stringify({
    "@graph": [
      org,
      website,
      breadcrumbs([
        { name: "Home", url: "https://motekarindo.co.id" },
        { name: "Kontak", url: "https://motekarindo.co.id/kontak" },
      ]),
    ],
  });
} else if (path === "/klien") {
  schema = JSON.stringify({
    "@graph": [
      org,
      website,
      breadcrumbs([
        { name: "Home", url: "https://motekarindo.co.id" },
        { name: "Klien", url: "https://motekarindo.co.id/klien" },
      ]),
    ],
  });
} else {
  schema = JSON.stringify({ "@graph": [org, website] });
}
---

<script type="application/ld+json" set:html={schema} />
