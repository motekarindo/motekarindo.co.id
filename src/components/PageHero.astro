---
interface Props { eyebrow: string; title: string; description: string; }
const { eyebrow, title, description } = Astro.props;
---

<section class="bg-grid border-b border-line">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24">
    <p class="eyebrow text-sm font-semibold uppercase tracking-[0.06em] text-brand-700">{eyebrow}</p>
    <h1 class="mt-4 max-w-4xl font-heading text-4xl font-extrabold leading-[1.05] tracking-[-0.035em] text-ink sm:text-5xl lg:text-[3.5rem]">
      {title}
    </h1>
    <p class="mt-6 max-w-3xl text-lg leading-8 text-muted">{description}</p>
  </div>
</section>
