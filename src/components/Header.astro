---
const navItems = [
  { href: "/", label: "Home" },
  { href: "/layanan", label: "Layanan" },
  // { href: "/solusi", label: "Solusi" },
  { href: "/produk", label: "Produk" },
  { href: "/klien", label: "Klien" },
  { href: "/portofolio", label: "Portofolio" },
  { href: "/tentang", label: "Tentang Kami" },
  { href: "/kontak", label: "Kontak" },
];
const currentPath = Astro.url.pathname;
---

<div class="border-b border-line bg-brand-50 text-xs font-medium uppercase tracking-[0.05em] text-muted">
  <div class="mx-auto flex max-w-7xl justify-between gap-4 px-5 py-2 sm:px-6 lg:px-8">
    <span class="hidden sm:inline">PT Motekar Teknologi Indonesia</span>
    <span><span class="text-brand-600" aria-hidden="true">●</span> Bogor, Jawa Barat · Konsultasi awal gratis</span>
  </div>
</div>

<header class="sticky top-0 z-50 border-b border-line bg-white/95 backdrop-blur-lg">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-5 py-3.5 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-2.5 shrink-0" aria-label="Motekar Teknologi Indonesia — Home">
      <svg class="size-8 shrink-0" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="var(--color-brand-600)"/><path d="M16 44V20h7.5L32 33.2 40.5 20H48v24h-7V31.6l-6.4 9.7h-5.2L23 31.6V44h-7Z" fill="#fff"/></svg>
      <span class="leading-tight">
        <span class="block font-heading text-lg font-extrabold tracking-[-0.02em] text-ink">Motekarindo</span>
        <span class="hidden text-[11px] font-medium text-soft sm:block">Motekar Teknologi Indonesia</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 lg:flex" aria-label="Navigasi utama">
      {navItems.map((item) => {
        const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
        return (
          <a
            href={item.href}
            aria-current={isActive ? "page" : undefined}
            class={`rounded-lg px-3 py-2 text-[15px] font-medium transition-colors ${
              isActive ? "bg-brand-50 font-semibold text-brand-700" : "text-muted hover:bg-surface-alt hover:text-ink"
            }`}
          >
            {item.label}
          </a>
        );
      })}
    </nav>

    <a
      href="/kontak"
      class="hidden min-h-11 items-center rounded-lg bg-brand-600 px-5 text-sm font-semibold text-white transition-colors hover:bg-brand-700 lg:inline-flex"
    >
      Konsultasi Gratis
    </a>

    <button id="menu-btn" class="inline-flex size-11 items-center justify-center rounded-lg text-muted hover:bg-surface-alt lg:hidden" aria-label="Buka menu" aria-expanded="false" aria-controls="mobile-nav">
      <svg id="icon-open" class="size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M4 6h16M4 12h16M4 18h16"/></svg>
      <svg id="icon-close" class="hidden size-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" d="M6 6l12 12M18 6L6 18"/></svg>
    </button>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-line bg-white px-5 pb-4 pt-2 lg:hidden" aria-label="Navigasi mobile">
    {navItems.map((item) => {
      const isActive = currentPath === item.href || (item.href !== "/" && currentPath.startsWith(item.href));
      return (
        <a href={item.href} aria-current={isActive ? "page" : undefined} class={`block rounded-lg px-3 py-3 text-[15px] font-medium transition-colors ${isActive ? "bg-brand-50 text-brand-700" : "text-muted hover:bg-surface-alt hover:text-ink"}`}>{item.label}</a>
      );
    })}
    <a href="/kontak" class="mt-2 block rounded-lg bg-brand-600 px-4 py-3 text-center text-sm font-semibold text-white hover:bg-brand-700">Konsultasi Gratis</a>
  </nav>
</header>

<script>
  const btn = document.getElementById("menu-btn");
  const nav = document.getElementById("mobile-nav");
  const o = document.getElementById("icon-open");
  const c = document.getElementById("icon-close");
  if (btn && nav) btn.addEventListener("click", () => {
    const e = btn.getAttribute("aria-expanded") === "true";
    btn.setAttribute("aria-expanded", String(!e));
    nav.classList.toggle("hidden");
    o?.classList.toggle("hidden");
    c?.classList.toggle("hidden");
  });
</script>
