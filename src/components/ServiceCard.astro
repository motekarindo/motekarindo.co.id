---
interface Props { title: string; summary: string; category?: string; icon?: string; href?: string; index?: number; }
const { title, summary, category, href, index } = Astro.props;
const num = typeof index === "number" ? String(index + 1).padStart(2, "0") : undefined;
---

<article class="group relative border-b border-line py-8 pr-8">
  {(num || category) && (
    <p class="text-sm font-semibold text-soft">{num ?? category}</p>
  )}
  <h3 class="mt-2.5 font-heading text-xl font-bold tracking-[-0.01em] text-ink transition-colors group-hover:text-brand-700">
    {href ? <a href={href} class="after:absolute after:inset-0">{title}</a> : title}
  </h3>
  <p class="mt-2 text-[15px] leading-7 text-muted line-clamp-3">{summary}</p>
</article>
