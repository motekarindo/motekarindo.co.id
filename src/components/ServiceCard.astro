---
interface Props { title: string; summary: string; category?: string; icon?: string; href?: string; }
const { title, summary, category, icon, href } = Astro.props;
const iconMap: Record<string, string> = {
  consult: "💡",
  web: "🌐",
  apps: "⚙️",
  journal: "📰",
  repository: "📚", server: "🖥️",
  install: "📥",
  support: "🔧",
  migrate: "📦",
  troubleshoot: "🔧",
  backup: "🛡️"
};
const emoji = icon ? (iconMap[icon] ?? "⚡") : "⚡";
---

<article class="group relative rounded-xl py-7 px-5 transition-all duration-300 bg-brand-50 hover:bg-brand-100">
  <span class="flex justify-center text-4xl transition-transform duration-300 group-hover:scale-110" aria-hidden="true">{emoji}</span>
  <h3 class="mt-5 font-heading text-lg font-bold text-ink transition-colors group-hover:text-brand-600">
    {href ? <a href={href} class="after:absolute after:inset-0">{title}</a> : title}
  </h3>
  <p class="mt-2.5 text-sm leading-7 text-muted">{summary}</p>
  {href && <span class="mt-3 inline-block text-sm font-semibold text-brand-600">Lihat detail &rarr;</span>}
</article>
