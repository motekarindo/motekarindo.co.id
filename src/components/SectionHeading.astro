---
interface Props { eyebrow?: string; title: string; description?: string; align?: "left" | "center"; }
const { eyebrow, title, description, align = "left" } = Astro.props;
const centered = align === "center";
---

<div class={centered ? "mx-auto max-w-3xl text-center" : "max-w-3xl"}>
  {eyebrow && (
    <p class="eyebrow text-sm font-semibold uppercase tracking-[0.06em] text-brand-700">{eyebrow}</p>
  )}
  <h2 class="mt-3 font-heading text-3xl font-extrabold leading-[1.1] tracking-[-0.03em] text-ink sm:text-4xl">{title}</h2>
  {description && <p class="mt-4 text-lg leading-8 text-muted">{description}</p>}
</div>
