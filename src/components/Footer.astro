---
import { site } from "@/lib/site.data.ts"
import { getCollection } from "astro:content";
import { byOrder, serviceName } from "@/lib/content";
const currentYear = new Date().getFullYear();
const navLinks = [
  { href: "/layanan", label: "Layanan" },
  // { href: "/solusi", label: "Solusi" },
  { href: "/produk", label: "Produk" },
  { href: "/klien", label: "Klien" },
  { href: "/portofolio", label: "Portofolio" },
  { href: "/tentang", label: "Tentang Kami" },
  { href: "/kontak", label: "Kontak" },
];
const serviceLinks = byOrder(await getCollection("services"))
  .filter((s) => s.data.is_published === true)
  .map((s) => ({ href: `/layanan/${s.data.slug}`, label: serviceName(s.data.title) }));

const whatsApp = `https://wa.me/${site.whatsApp}?text=Halo%20*Motekarindo*.`;
---

<footer class="bg-asphalt text-white">
  <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 lg:px-8 lg:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_1fr_1fr_1.2fr] lg:gap-10">
      <div>
        <div class="flex items-center gap-2.5">
          <svg class="size-8 shrink-0" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="14" fill="var(--color-brand-600)"/><path d="M16 44V20h7.5L32 33.2 40.5 20H48v24h-7V31.6l-6.4 9.7h-5.2L23 31.6V44h-7Z" fill="#fff"/></svg>
          <p class="font-heading text-lg font-extrabold tracking-[-0.02em]">Motekarindo</p>
        </div>
        <p class="mt-2 text-sm font-medium text-neutral-400">PT Motekar Teknologi Indonesia</p>
        <p class="mt-5 max-w-sm text-[15px] leading-7 text-neutral-300">
          Tim IT dari Bogor yang membangun dan merawat sistem digital untuk pemerintah daerah, kampus, dan bisnis. Terukur, terdokumentasi, bisa dirawat.
        </p>
        <a href="https://linkedin.com/company/motekar-teknologi-indonesia" target="_blank" rel="noopener" class="mt-6 inline-flex min-h-11 items-center gap-2 rounded-lg border border-white/20 px-4 text-sm font-semibold text-white transition-colors hover:border-white/50">
          <svg class="size-4" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/></svg>
          LinkedIn
        </a>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-neutral-400">Navigasi</h2>
        <ul class="mt-4 grid gap-2.5">
          {navLinks.map((link) => (<li><a href={link.href} class="text-[15px] text-neutral-200 transition-colors hover:text-white">{link.label}</a></li>))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-neutral-400">Layanan</h2>
        <ul class="mt-4 grid gap-2.5">
          {serviceLinks.map((link) => (<li><a href={link.href} class="text-[15px] text-neutral-200 transition-colors hover:text-white">{link.label}</a></li>))}
        </ul>
      </div>

      <div>
        <h2 class="text-sm font-semibold text-neutral-400">Hubungi Kami</h2>
        <ul class="mt-4 grid gap-3 text-[15px]">
          <li><a href={`mailto:${site.email}`} class="text-neutral-200 transition-colors hover:text-white">{site.email}</a></li>
          <li><a href={whatsApp} target="_blank" rel="noopener noreferrer" class="text-neutral-200 transition-colors hover:text-white">WhatsApp +{site.whatsApp}</a></li>
        </ul>
        <h2 class="mt-6 text-sm font-semibold text-neutral-400">Alamat</h2>
        <address class="mt-3 text-[15px] not-italic leading-7 text-neutral-200">{site.address}</address>
      </div>
    </div>
  </div>
  <div class="border-t border-white/10">
    <p class="mx-auto max-w-7xl px-5 py-6 text-sm text-neutral-400 sm:px-6 lg:px-8">&copy; {currentYear} PT Motekar Teknologi Indonesia. Bogor, Jawa Barat.</p>
  </div>
</footer>
