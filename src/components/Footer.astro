---
import { site } from "@/lib/site.data.ts"
const currentYear = new Date().getFullYear();
const navLinks = [
  { href: "/layanan", label: "Layanan" },
  // { href: "/solusi", label: "Solusi" },
  { href: "/produk", label: "Produk" },
  { href: "/klien", label: "Klien" },
  { href: "/portofolio", label: "Portofolio" },
  { href: "/tentang", label: "Tentang Kami" },
  { href: "/kontak", label: "Kontak" },
];
const serviceLinks = [
  { href: "/layanan/konsultan-it", label: "Konsultan IT" },
  { href: "/layanan/web-development", label: "Web Development" },
  { href: "/layanan/devops-sysadmin", label: "DevOps & SysAdmin" },
  { href: "/layanan/qa-testing", label: "QA & Testing" },
  { href: "/layanan/instalasi-aplikasi", label: "Instalasi Aplikasi" },
  { href: "/layanan/install-ojs", label: "Instalasi OJS" },
  { href: "/layanan/maintenance-server", label: "Maintenance Server" },
];

const whatsApp = `https://wa.me/${site.whatsApp}?text=Halo%20*Motekarindo*.`;
---

<footer class="bg-asphalt text-white">
  <div class="mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:px-8">
    <div class="grid gap-12 lg:grid-cols-2 xl:grid-cols-[1.5fr_1fr_1fr_1fr] xl:gap-8">
      <div class="lg:col-span-2 xl:col-span-1">
        <div class="flex items-start gap-3">
          <span class="grid size-12 shrink-0 place-items-center rounded-lg bg-white font-heading text-sm font-bold text-brand-600 mt-1">M</span>
          <div>
            <p class="font-heading text-base sm:text-lg font-bold text-white">PT Motekar Teknologi Indonesia</p>
            <p class="mt-0 text-base font-bold text-neutral-50">Terukur. Terdokumentasi. Bisa Dirawat.</p>
          </div>
        </div>
        <p class="mt-5 max-w-sm text-base leading-7 text-neutral-50 font-semibold">
          Membantu bisnis dan institusi membangun sistem digital dengan standar yang sama: setiap proyek didokumentasikan, setiap hasil terukur, setiap sistem bisa dikelola sendiri.
        </p>
        <div class="mt-2">
            <a href="https://linkedin.com/company/motekar-teknologi-indonesia" target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-full border px-4 py-2 text-sm font-semibold text-white transition-colors hover:bg-brand-800">
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor"><path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"></svg>
              LinkedIn
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 md:grid-cols-3 xl:col-span-3">
        <div>
          <h2 class="font-heading text-base font-bold uppercase tracking-[0.15em] text-white">Navigasi</h2>
          <ul class="mt-4 grid gap-2.5">
            {navLinks.map((link) => (<li><a href={link.href} class="text-base font-semibold text-neutral-200 transition-colors hover:text-white">{link.label}</a></li>))}
          </ul>
        </div>

        <div>
          <h2 class="font-heading text-base font-bold uppercase tracking-[0.15em] text-white">Layanan</h2>
          <ul class="mt-4 grid gap-2.5">
            {serviceLinks.map((link) => (<li><a href={link.href} class="text-base font-semibold text-neutral-200 transition-colors hover:text-white">{link.label}</a></li>))}
          </ul>
        </div>

        <div>
          <h2 class="font-heading text-base font-bold uppercase tracking-[0.15em] text-white">Hubungi Kami</h2>
          <ul class="mt-4 grid gap-3 text-sm">
            <li>
                <a href={`mailto:${site.email}`} class="inline-flex items-center gap-2 text-base font-semibold text-neutral-200 transition-colors hover:text-white">
                    <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
                    {site.email}</a>
            </li>
            <li>
                <a href={`https://wa.me/${site.whatsApp}`} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-base font-semibold text-neutral-200 transition-colors hover:text-white">
                    <svg class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                    {site.whatsApp}
                </a>
            </li>
          </ul>
          <h2 class="mt-5 font-heading text-base font-bold uppercase tracking-[0.15em] text-white">Alamat</h2>
          <ul class="mt-2 grid gap-3 text-sm">
            <li>
                <p  class="inline-flex items-center gap-2 text-base font-semibold text-neutral-200 transition-colors hover:text-white">
                    {site.address}
                </p>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <div class="bg-brand-600">
    <div class="border-t-2 border-brand-600 px-5 py-5">
    <p class="text-center text-lg font-bold text-white">&copy; {currentYear} PT Motekar Teknologi Indonesia. All rights reserved.</p>
  </div>
</footer>
