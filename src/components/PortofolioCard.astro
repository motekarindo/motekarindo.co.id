---
interface Props {
  title: string;
  client: string;
  problem: string;
  outcome: string;
  technologies: string[];
  metrics?: { label: string; value: string }[];
  href?: string;
}

const { title, client, problem, outcome, technologies, metrics, href } = Astro.props;
// Tampilkan hanya metrik yang benar-benar angka ("655.000+", "<15m", "0"), bukan label seperti "Online" atau "Live".
const numeric = (metrics ?? []).filter((m) => /\d/.test(m.value)).slice(0, 4);
const showMetrics = numeric.length >= 2;
---

{href ? (
  <a
    href={href}
    class="group block rounded-2xl border border-line bg-white p-6 transition-colors hover:border-brand-600 sm:p-8"
  >
    <p class="text-sm font-semibold text-soft">{client}</p>
    <h3 class="mt-3 font-heading text-xl font-bold leading-snug text-ink group-hover:text-brand-700 transition-colors">{title}</h3>
    <p class="mt-4 text-sm leading-7 text-muted line-clamp-2">{problem}</p>

    {showMetrics ? (
      <div class="mt-5 grid grid-cols-2 gap-3">
        {numeric.map((m) => (
          <div class="rounded-lg bg-surface-alt p-3">
            <p class="font-heading text-2xl font-extrabold tracking-[-0.02em] text-ink">{m.value}</p>
            <p class="mt-0.5 text-[13px] text-muted">{m.label}</p>
          </div>
        ))}
      </div>
    ) : (
      <div class="mt-5 rounded-lg bg-surface-alt p-4">
        <span class="text-sm font-semibold text-soft">Hasil</span>
        <p class="mt-1 text-ink font-medium">{outcome}</p>
      </div>
    )}

    <div class="mt-5 flex flex-wrap gap-2">
      {technologies.map((tech) => (
        <span class="rounded-md border border-line px-2.5 py-1 text-xs font-medium text-muted">{tech}</span>
      ))}
    </div>

    <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-700 transition-all group-hover:gap-2">
      Lihat studi kasus
      <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
    </span>
  </a>
) : (
  <article class="group rounded-2xl border border-line bg-white p-6 transition-colors hover:border-brand-600 sm:p-8">
    <p class="text-sm font-semibold text-soft">{client}</p>
    <h3 class="mt-3 font-heading text-xl font-bold leading-snug text-ink">{title}</h3>
    <p class="mt-4 text-sm leading-7 text-muted line-clamp-2">{problem}</p>

    {showMetrics ? (
      <div class="mt-5 grid grid-cols-2 gap-3">
        {numeric.map((m) => (
          <div class="rounded-lg bg-surface-alt p-3">
            <p class="font-heading text-2xl font-extrabold tracking-[-0.02em] text-ink">{m.value}</p>
            <p class="mt-0.5 text-[13px] text-muted">{m.label}</p>
          </div>
        ))}
      </div>
    ) : (
      <div class="mt-5 rounded-lg bg-surface-alt p-4">
        <span class="text-sm font-semibold text-soft">Hasil</span>
        <p class="mt-1 text-ink font-medium">{outcome}</p>
      </div>
    )}

    <div class="mt-5 flex flex-wrap gap-2">
      {technologies.map((tech) => (
        <span class="rounded-md border border-line px-2.5 py-1 text-xs font-medium text-muted">{tech}</span>
      ))}
    </div>
  </article>
)}
