---
interface Props {
  title: string;
  client: string;
  problem: string;
  outcome: string;
  technologies: string[];
  metrics?: { label: string; value: string }[];
  href?: string;
}

const { title, client, problem, outcome, technologies, metrics, href } = Astro.props;
---

{href ? (
  <a
    href={href}
    class="group block rounded-xl border-2 border-line bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:border-brand-500 sm:p-8"
  >
    <p class="text-xs font-bold uppercase tracking-[0.12em] text-brand-600">{client}</p>
    <h3 class="mt-3 font-heading text-xl font-bold leading-snug text-ink group-hover:text-brand-600 transition-colors">{title}</h3>
    <p class="mt-4 text-sm leading-7 text-muted line-clamp-2">{problem}</p>

    {metrics && metrics.length > 0 ? (
      <div class="mt-5 grid grid-cols-2 gap-3">
        {metrics.map((m) => (
          <div class="rounded-lg bg-brand-50 p-3 text-center">
            <p class="font-heading text-xl font-extrabold text-brand-600">{m.value}</p>
            <p class="mt-0.5 text-[11px] font-semibold uppercase tracking-[0.06em] text-muted">{m.label}</p>
          </div>
        ))}
      </div>
    ) : (
      <div class="mt-5 rounded-lg bg-brand-100 p-4">
        <span class="text-sm font-bold uppercase tracking-[0.1em] text-brand-600">Hasil</span>
        <p class="mt-1 text-muted text-gray-700 font-semibold">{outcome}</p>
      </div>
    )}

    <div class="mt-5 flex flex-wrap gap-2">
      {technologies.map((tech) => (
        <span class="rounded-full border border-line bg-brand-100 px-3 py-1 text-xs font-semibold text-muted">{tech}</span>
      ))}
    </div>

    <span class="mt-4 inline-flex items-center gap-1 text-sm font-semibold text-brand-600 transition-all group-hover:gap-2">
      Lihat studi kasus
      <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
    </span>
  </a>
) : (
  <article class="group rounded-xl border-2 border-line bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:border-brand-500 sm:p-8">
    <p class="text-xs font-bold uppercase tracking-[0.12em] text-brand-600">{client}</p>
    <h3 class="mt-3 font-heading text-xl font-bold leading-snug text-ink">{title}</h3>
    <p class="mt-4 text-sm leading-7 text-muted line-clamp-2">{problem}</p>

    {metrics && metrics.length > 0 ? (
      <div class="mt-5 grid grid-cols-2 gap-3">
        {metrics.map((m) => (
          <div class="rounded-lg bg-brand-50 p-3 text-center">
            <p class="font-heading text-xl font-extrabold text-brand-600">{m.value}</p>
            <p class="mt-0.5 text-[11px] font-semibold uppercase tracking-[0.06em] text-muted">{m.label}</p>
          </div>
        ))}
      </div>
    ) : (
      <div class="mt-5 rounded-lg bg-brand-100 p-4">
        <span class="text-sm font-bold uppercase tracking-[0.1em] text-brand-600">Hasil</span>
        <p class="mt-1 text-muted text-gray-700 font-semibold">{outcome}</p>
      </div>
    )}

    <div class="mt-5 flex flex-wrap gap-2">
      {technologies.map((tech) => (
        <span class="rounded-full border border-line bg-brand-100 px-3 py-1 text-xs font-semibold text-muted">{tech}</span>
      ))}
    </div>
  </article>
)}
