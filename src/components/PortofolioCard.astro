---
interface Props { title: string; client: string; problem: string; solution: string; technologies: string[]; outcome: string; href?: string; }
const { title, client, problem, solution, technologies, outcome, href } = Astro.props;
---

{href ? (
  <a href={href} class="block group rounded-xl border-2 border-line bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:border-brand-500 sm:p-8">
    <p class="text-xs font-bold uppercase tracking-[0.12em] text-brand-600">{client}</p>
    <h3 class="mt-3 font-heading text-xl font-bold leading-snug text-ink transition-colors group-hover:text-brand-600">{title}</h3>
    <div class="mt-6 grid gap-4 text-sm leading-7">
      <div class="rounded-lg bg-neutral-50 p-4">
        <span class="text-xs font-bold uppercase tracking-[0.1em] text-soft">Masalah</span>
        <p class="mt-1 text-muted font-medium">{problem}</p>
      </div>
      <div class="rounded-lg bg-brand-600 p-4">
        <span class="text-sm font-bold uppercase tracking-[0.1em] text-brand-100">Yang Dikerjakan</span>
        <p class="mt-1 text-white font-semibold font-medium">{solution}</p>
      </div>
      <div class="rounded-lg bg-brand-100 p-4">
        <span class="text-sm font-bold uppercase tracking-[0.1em] text-brand-600">Hasil</span>
        <p class="mt-1 text-muted text-gray-700 font-semibold font-medium">{outcome}</p>
      </div>
    </div>
    <div class="mt-5 flex flex-wrap gap-2">
      {technologies.map((tech) => (<span class="rounded-full border border-line bg-brand-100 px-3 py-1 text-xs font-semibold text-muted">{tech}</span>))}
    </div>
  </a>
) : (
  <article class="group rounded-xl border-2 border-line bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:border-brand-500 sm:p-8">
    <p class="text-xs font-bold uppercase tracking-[0.12em] text-brand-600">{client}</p>
    <h3 class="mt-3 font-heading text-xl font-bold leading-snug text-ink transition-colors group-hover:text-brand-600">{title}</h3>
    <div class="mt-6 grid gap-4 text-sm leading-7">
      <div class="rounded-lg bg-neutral-50 p-4">
        <span class="text-xs font-bold uppercase tracking-[0.1em] text-soft">Masalah</span>
        <p class="mt-1 text-muted font-medium">{problem}</p>
      </div>
      <div class="rounded-lg bg-brand-600 p-4">
        <span class="text-sm font-bold uppercase tracking-[0.1em] text-brand-100">Yang Dikerjakan</span>
        <p class="mt-1 text-white font-semibold font-medium">{solution}</p>
      </div>
      <div class="rounded-lg bg-brand-100 p-4">
        <span class="text-sm font-bold uppercase tracking-[0.1em] text-brand-600">Hasil</span>
        <p class="mt-1 text-muted text-gray-700 font-semibold font-medium">{outcome}</p>
      </div>
    </div>
    <div class="mt-5 flex flex-wrap gap-2">
      {technologies.map((tech) => (<span class="rounded-full border border-line bg-brand-100 px-3 py-1 text-xs font-semibold text-muted">{tech}</span>))}
    </div>
  </article>
)}
