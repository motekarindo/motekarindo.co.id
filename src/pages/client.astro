---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { byOrder } from "@/lib/content";

const clients = byOrder(await getCollection("clients"));
const title = "Client | Motekar Teknologi Indonesia";
const description = "Klien dan sektor yang menjadi fokus layanan Motekar Teknologi Indonesia — dari pendidikan hingga percetakan digital.";
---

<BaseLayout title={title} description={description}>
  <main>
    <PageHero eyebrow="Klien" title="Klien dan institusi yang menjadi fokus layanan" description="Motekar menjaga kepercayaan klien. Nama dan logo hanya ditampilkan setelah persetujuan publikasi." />
    <section class="bg-brand-50 py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <div class="grid gap-5 md:grid-cols-3">
          {clients.map((client) => (
            <article class="group rounded-xl border-2 border-brand-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-brand-500">
              <span class="inline-block rounded-full bg-brand-100 px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.1em] text-brand-700">{client.data.category}</span>
              <h2 class="mt-4 font-heading text-xl font-bold text-ink group-hover:text-brand-600 transition-colors">{client.data.name}</h2>
              <p class="mt-3 text-sm leading-7 text-muted">{client.data.description}</p>
              <p class="mt-4 rounded-lg bg-brand-100 p-3 text-xs font-semibold text-brand-700">{client.data.public ? "✅ Publik" : "🔒 Disamarkan"}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
