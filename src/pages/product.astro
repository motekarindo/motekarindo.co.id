---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { byOrder, statusLabel } from "@/lib/content";

const products = byOrder(await getCollection("products"));
const title = "Product | Motekar Teknologi Indonesia";
const description = "Product Motekar disiapkan untuk pengembangan aplikasi dan tools digital.";
---

<BaseLayout title={title} description={description}>
  <main>
    <PageHero eyebrow="Product" title="Produk digital sedang disiapkan" description="Menu Product untuk aplikasi dan tools milik Motekar. Dikembangkan bertahap berdasarkan kebutuhan proyek dan masukan klien." />
    <section class="mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid gap-6 lg:grid-cols-2">
        {products.map((p) => (
          <article class="group rounded-xl border-2 border-line bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-brand-500">
            <span class="inline-block rounded-full bg-brand-600 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-white shadow-sm">{statusLabel(p.data.status)}</span>
            <h2 class="mt-5 font-heading text-2xl font-bold text-ink group-hover:text-brand-600 transition-colors">{p.data.title}</h2>
            <p class="mt-3 text-sm leading-7 text-muted">{p.data.summary}</p>
            <p class="mt-5 rounded-lg bg-brand-50 p-4 text-sm font-semibold leading-7 text-brand-800">Untuk: {p.data.audience}</p>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
