---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";

const title = "Tentang Motekar \u2014 Dari Tim Internal, untuk Organisasi Tanpa Tim IT";
const description = "Berangkat dari pengalaman sebagai tim internal \u2014 Motekarindo paham kebutuhan sistem yang rapi, terdokumentasi, dan mudah dikelola.";

const values = [
  { label: "Jelas", desc: "Komunikasi teknis dalam bahasa yang dipahami klien." },
  { label: "Terukur", desc: "Hasil pekerjaan memiliki tolok ukur yang diverifikasi." },
  { label: "Dapat Dirawat", desc: "Sistem dirancang agar mudah dikelola pasca proyek." },
];
---

<BaseLayout title={title} description={description}>
  <main>
    <PageHero eyebrow="Tentang Kami" title="Dari tim internal, untuk organisasi yang belum punya tim IT." description="Kami tahu rasanya mewarisi sistem tanpa dokumentasi, server down tanpa ada yang bisa dihubungi, developer yang hilang tanpa jejak. Dari pengalaman itu, Motekar lahir — dengan standar yang berbeda." />
    <section class="mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <span class="inline-block rounded-full bg-brand-600 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-white shadow-sm">Fokus</span>
          <h2 class="mt-5 font-heading text-3xl font-extrabold leading-tight text-ink sm:text-4xl">Sistem yang rapi, stabil, dan mudah dikelola.</h2>
        </div>
        <div class="grid gap-6 text-base leading-8 text-muted">
          <p>Motekar membantu bisnis dan institusi merencanakan serta menjalankan pekerjaan teknis: website, aplikasi, DevOps, QA, setup server, dan migrasi.</p>
          <p>Setiap pekerjaan dimulai dari pemahaman kebutuhan, kondisi sistem, dan prioritas risiko — hasilnya sistem yang lebih mudah dijelaskan, diuji, dan dikelola.</p>
          <div class="mt-4 grid gap-4 sm:grid-cols-3">
            {values.map(({ label, desc }) => (
              <div class="rounded-xl border-2 border-brand-200 bg-white p-5 shadow-sm transition-all hover:-translate-y-1 hover:shadow-md hover:border-brand-500">
                <p class="font-heading text-lg font-bold text-brand-700">{label}</p>
                <p class="mt-2 text-sm leading-7 text-muted">{desc}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
