---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { getCollection } from "astro:content";
import { byOrder } from "@/lib/content";
import { site } from "@/lib/site.data";

const clients = byOrder(await getCollection("clients")).filter((c) => c.data.is_published === true);

const title = "Tentang Motekarindo \u2014 Dari Tim Internal, untuk Organisasi Tanpa Tim IT";
const description = "Berangkat dari pengalaman sebagai tim internal \u2014 Motekarindo paham kebutuhan sistem yang rapi, terdokumentasi, dan bisa dirawat.";

// Tiga prinsip kerja (dulu terpisah jadi "Nilai Kami" dan "Kenapa Motekarindo" yang isinya tumpang tindih).
const principles = [
  { label: "Hasil yang bisa dicek", desc: "Setiap pekerjaan punya tolok ukur yang diverifikasi sebelum serah terima — waktu muat, uptime, alur yang berjalan." },
  { label: "Semua tercatat", desc: "Setup, konfigurasi, dan keputusan teknis didokumentasikan. Kredensial dan catatan diserahkan ke Anda." },
  { label: "Anda tidak dikunci", desc: "Sistem dirancang agar bisa dirawat tim Anda sendiri atau vendor lain. Kami pernah di posisi klien — kami tahu rasanya." },
];

const faqs = [
  { q: "Apakah Motekarindo hanya melayani klien di area tertentu?", a: "Tidak. Kami melayani klien di seluruh Indonesia. Komunikasi dan pengerjaan bisa dilakukan secara remote \u2014 termasuk instalasi, konfigurasi, dan maintenance server." },
  { q: "Bagaimana cara memulai kerja sama dengan Motekarindo?", a: "Mudah. Hubungi kami via WhatsApp atau email, ceritakan kebutuhan Anda. Kami akan beri rekomendasi awal gratis. Setelah sepakat scope, kami kirim proposal transparan \u2014 tanpa biaya tersembunyi." },
  { q: "Apakah ada garansi untuk hasil pekerjaan?", a: "Ya. Setiap proyek disertai masa garansi 1-2 minggu untuk perbaikan bug terkait pekerjaan kami. Setelah itu, Anda bisa melanjutkan dengan paket maintenance bulanan jika diperlukan." },
];
---

<BaseLayout title={title} description={description}>
  <main>
    <PageHero eyebrow="Tentang Kami" title="Dari tim internal, untuk organisasi yang belum punya tim IT." description="Kami tahu rasanya mewarisi sistem tanpa dokumentasi, server down tanpa ada yang bisa dihubungi, developer yang hilang tanpa jejak. Dari pengalaman itu, Motekarindo lahir — dengan standar yang berbeda." />

    <section class="mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid gap-14 lg:grid-cols-[0.9fr_1.1fr]">
        <div>
          <p class="eyebrow text-sm font-semibold uppercase tracking-[0.06em] text-brand-700">Cerita kami</p>
          <h2 class="mt-3 font-heading text-3xl font-extrabold leading-[1.1] tracking-[-0.03em] text-ink sm:text-4xl">Kami pernah jadi pihak yang ditinggal vendor.</h2>
        </div>
        <div class="grid gap-6 text-[17px] leading-8 text-muted">
          <p>Motekarindo lahir dari pengalaman sebagai tim IT internal. Kami tahu bagaimana rasanya: sistem yang diwariskan tanpa dokumentasi, server yang tiba-tiba down, developer eksternal yang tidak bisa dihubungi setelah proyek selesai.</p>
          <p>Dari situ kami memutuskan: setiap proyek harus meninggalkan sistem yang lebih baik dari sebelumnya — dan bisa dirawat tanpa harus bergantung pada kami.</p>
        </div>
      </div>

      <ol class="mt-16 grid gap-10 sm:grid-cols-3">
        {principles.map(({ label, desc }, i) => (
          <li class="border-t-2 border-ink pt-6">
            <p class="text-sm font-semibold text-soft">{String(i + 1).padStart(2, "0")}</p>
            <h3 class="mt-2 font-heading text-xl font-bold text-ink">{label}</h3>
            <p class="mt-2 text-[15px] leading-7 text-muted">{desc}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="border-y border-line bg-surface-alt">
      <div class="mx-auto grid max-w-7xl gap-10 px-5 py-20 sm:px-6 md:grid-cols-3 lg:px-8">
        <div>
          <h2 class="text-sm font-semibold text-soft">Badan usaha</h2>
          <p class="mt-2 font-heading text-lg font-bold text-ink">PT Motekar Teknologi Indonesia</p>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-soft">Kantor</h2>
          <address class="mt-2 text-[15px] not-italic leading-7 text-ink">{site.address}</address>
        </div>
        <div>
          <h2 class="text-sm font-semibold text-soft">Klien</h2>
          <ul class="mt-2 grid gap-1 text-[15px] leading-7">
            {clients.map((c) => (<li><a href={`/klien/${c.data.slug}`} class="text-ink hover:text-brand-700">{c.data.name}</a></li>))}
          </ul>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-4xl px-5 py-20 sm:px-6 lg:px-8 lg:py-24">
      <h2 class="font-heading text-3xl font-extrabold tracking-[-0.03em] text-ink sm:text-4xl">Yang sering ditanyakan</h2>
      <div class="mt-12 grid gap-6">
        {faqs.map(({ q, a }) => (
          <div class="rounded-2xl border border-line bg-white p-6">
            <h3 class="font-heading text-lg font-bold text-ink">{q}</h3>
            <p class="mt-3 text-sm leading-7 text-muted">{a}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="bg-asphalt px-5 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto flex max-w-3xl flex-col items-center text-center gap-6">
        <h2 class="font-heading text-3xl font-extrabold text-white sm:text-4xl">Siap bekerja sama?</h2>
        <p class="text-lg leading-8 text-white">Ceritakan kebutuhan teknis Anda — kami bantu arahkan solusi yang paling masuk akal, tanpa biaya konsultasi awal.</p>
        <a href="/kontak" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-8 py-4 text-base font-bold text-white transition-all hover:bg-brand-500">
          Ceritakan Kebutuhan Anda
          <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
