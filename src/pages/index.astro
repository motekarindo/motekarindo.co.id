---

<BaseLayout title={title} description={description}>
  <main>

    <!-- ===== HERO ===== -->
    <section class="relative overflow-hidden border-b-2 border-brand-600 bg-brand-50">
      <div class="absolute inset-0 bg-dots opacity-30" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-7xl gap-12 px-5 py-20 sm:px-6 lg:grid-cols-[1fr_1fr] lg:px-8 lg:py-28">
        <div class="flex flex-col justify-center">
          <span class="inline-block w-fit rounded-full bg-brand-600 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-white shadow-sm">
            IT Consultant &bull; Web Dev &bull; DevOps &bull; QA
          </span>
          <h1 class="mt-6 max-w-xl font-heading text-4xl font-extrabold leading-tight text-ink sm:text-5xl lg:text-[3.75rem]">
            Mitra <span class="text-brand-600">teknologi</span> untuk bisnis dan <span class="text-brand-600">organisasi.</span>
          </h1>
          <p class="mt-6 max-w-lg text-lg leading-8 text-muted">
            Kami membantu bisnis, startup, percetakan digital, dan institusi membangun website, aplikasi, serta mengelola infrastruktur server.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href="/kontak" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3.5 text-sm font-bold text-white shadow-md shadow-brand-600/30 transition-all hover:bg-brand-700 hover:shadow-lg hover:shadow-brand-600/40">
              Konsultasi Gratis
              <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/layanan" class="inline-flex items-center gap-2 rounded-lg border-2 border-brand-600 bg-white px-6 py-3.5 text-sm font-semibold text-brand-700 transition-all hover:bg-brand-50 hover:text-brand-600">
              Lihat Layanan
            </a>
          </div>
        </div>

        <div class="hidden lg:grid grid-cols-2 gap-4 content-center">
          {skills.map(({ label, desc, svg }) => (
            <div class="group rounded-xl border-2 border-brand-200 bg-white p-5 shadow-sm transition-all hover:border-brand-400 hover:shadow-md hover:-translate-y-0.5">
              <div class="mx-auto w-full max-w-[120px]" set:html={svg} />
              <p class="mt-3 font-heading text-sm font-bold text-ink group-hover:text-brand-600 transition-colors">{label}</p>
              <p class="mt-1.5 text-xs leading-5 text-muted">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== LAYANAN ===== -->
    <section class="mx-auto max-w-7xl px-5 py-24 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Layanan"
        title="Layanan teknis dari konsultasi, pengembangan, hingga operasional"
        description="Layanan Motekar mencakup IT consulting, web development, DevOps, QA, instalasi aplikasi, dan maintenance server."
      />
      <div class="mt-14 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <ServiceCard title={s.data.title} summary={s.data.summary} category={s.data.category} icon={s.data.icon} href={`/layanan/${s.id}`} />
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/layanan" class="inline-flex items-center gap-2 rounded-lg border-2 border-brand-600 bg-white px-5 py-2.5 text-sm font-semibold text-brand-700 transition-all hover:bg-brand-50 hover:text-brand-600">
          Semua Layanan <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>

    <!-- ===== SOLUSI ===== -->
    <!-- <section class="border-y-2 border-brand-600 bg-surface py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <SectionHeading
          eyebrow="Solusi"
          title="Paket layanan untuk berbagai kebutuhan bisnis"
          description="Gabungan layanan yang disesuaikan dengan kebutuhan: percetakan digital, institusi pendidikan, perusahaan, atau organisasi."
        />
        <div class="mt-14 grid gap-8">
          {solutions.map((sol) => (
            <SolutionCard
              title={sol.data.title}
              eyebrow={sol.data.eyebrow}
