---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PortofolioCard from "@/components/PortofolioCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import { byOrder, featured } from "@/lib/content";
import { site } from "@/lib/site.data";

const services = featured(await getCollection("services")).slice(0, 6).filter((p) => p.data.is_published === true);
const clients = featured(await getCollection("clients")).filter((p) => p.data.is_published === true);

const logoList = import.meta.glob("/src/assets/images/klien/**/*.{jpg,jpeg,png,webp,avif}");

const clientCards: { data: (typeof clients)[number]["data"]; logoSrc?: string }[] = [];
for (const client of byOrder(clients)) {
  let logoSrc: string | undefined;
  if (client.data.logo) {
    for (const [path, loader] of Object.entries(logoList)) {
      if (path.endsWith("/" + client.data.logo)) {
        const m: any = await loader();
        logoSrc = m.default.src;
        break;
      }
    }
  }
  clientCards.push({ data: client.data, logoSrc });
}

const portofolio = featured(await getCollection("portofolio")).filter((p) => p.data.is_published === true).slice(0, 4);
const products = (await getCollection("products")).filter((p) => p.data.is_published === true);

const title = "Motekar Teknologi Indonesia \u2014 Sistem Digital Terukur & Terdokumentasi";
const description = "Jasa IT dengan dokumentasi lengkap: web development, DevOps, QA, dan maintenance server. Terukur, terdokumentasi, bisa dirawat sendiri.";
const whatsApp = `https://wa.me/${site.whatsApp}?text=Halo%20*Motekarindo*.%20Saya%20ingin%20konsultasi.`;
const skills = [
  {
    label: "Konsultasi IT",
    desc: "Dari pemetaan masalah sampai rekomendasi — semua didokumentasikan.",
    svg: `<svg viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="10" y="30" width="100" height="60" rx="6" fill="#2FA084" opacity="0.15"/>
      <rect x="20" y="40" width="80" height="5" rx="2" fill="#2FA084" opacity="0.5"/>
      <rect x="20" y="50" width="60" height="5" rx="2" fill="#2FA084" opacity="0.3"/>
      <rect x="20" y="60" width="70" height="5" rx="2" fill="#2FA084" opacity="0.3"/>
      <circle cx="45" cy="18" r="10" fill="#2FA084" opacity="0.2"/>
      <path d="M42 24C42 20 48 16 55 16C62 16 68 20 68 24C68 28 62 30 55 30C48 30 42 28 42 24Z" fill="#2FA084"/>
      <circle cx="52" cy="13" r="2" fill="#1F6F5F"/>
      <circle cx="60" cy="13" r="2" fill="#1F6F5F"/>
      <path d="M52 20C52 20 54 22 57 22C60 22 60 20 60 20" stroke="#1F6F5F" stroke-width="1.5" stroke-linecap="round"/>
      <circle cx="90" cy="22" r="14" fill="#6FCF97" stroke="#2FA084" stroke-width="2"/>
      <path d="M90 15V29M83 22H97" stroke="white" stroke-width="2.5" stroke-linecap="round"/>
      <circle cx="90" cy="22" r="4" fill="white"/>
    </svg>`,
  },
  {
    label: "Web Development",
    desc: "Website dan aplikasi yang Anda bisa kelola sendiri setelah selesai.",
    svg: `<svg viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="20" y="15" width="80" height="56" rx="8" fill="#2FA084" opacity="0.12" stroke="#2FA084" stroke-width="2"/>
      <rect x="20" y="15" width="80" height="12" rx="8" fill="#2FA084"/>
      <rect x="20" y="19" width="80" height="4" rx="2" fill="#2FA084"/>
      <circle cx="28" cy="21" r="2.5" fill="#6FCF97"/>
      <circle cx="36" cy="21" r="2.5" fill="#6FCF97"/>
      <circle cx="44" cy="21" r="2.5" fill="#6FCF97"/>
      <rect x="30" y="33" width="40" height="4" rx="2" fill="#2FA084" opacity="0.3"/>
      <rect x="30" y="41" width="55" height="4" rx="2" fill="#2FA084" opacity="0.3"/>
      <rect x="30" y="49" width="35" height="4" rx="2" fill="#2FA084" opacity="0.3"/>
      <rect x="30" y="57" width="25" height="4" rx="2" fill="#6FCF97" opacity="0.6"/>
      <path d="M78 71L84 77L78 83" stroke="#2FA084" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M42 71L36 77L42 83" stroke="#2FA084" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M58 68L62 86" stroke="#6FCF97" stroke-width="2" stroke-linecap="round"/>
    </svg>`,
  },
  {
    label: "QA & Testing",
    desc: "Setiap bug dicatat, setiap perbaikan diverifikasi. Tidak ada yang terlewat.",
    svg: `<svg viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="15" y="20" width="55" height="65" rx="3" fill="white" stroke="#2FA084" stroke-width="2"/>
      <rect x="28" y="30" width="29" height="3" rx="1.5" fill="#2FA084" opacity="0.4"/>
      <rect x="28" y="37" width="29" height="3" rx="1.5" fill="#2FA084" opacity="0.4"/>
      <rect x="28" y="44" width="20" height="3" rx="1.5" fill="#2FA084" opacity="0.4"/>
      <rect x="28" y="52" width="29" height="3" rx="1.5" fill="#2FA084" opacity="0.25"/>
      <rect x="28" y="59" width="25" height="3" rx="1.5" fill="#2FA084" opacity="0.25"/>
      <rect x="28" y="66" width="20" height="3" rx="1.5" fill="#2FA084" opacity="0.25"/>
      <rect x="52" y="22" width="55" height="65" rx="3" fill="#2FA084" stroke="#2FA084" stroke-width="2"/>
      <rect x="60" y="32" width="29" height="3" rx="1.5" fill="white" opacity="0.6"/>
      <rect x="60" y="39" width="29" height="3" rx="1.5" fill="white" opacity="0.6"/>
      <rect x="60" y="46" width="20" height="3" rx="1.5" fill="white" opacity="0.6"/>
      <rect x="60" y="54" width="29" height="3" rx="1.5" fill="white" opacity="0.35"/>
      <rect x="60" y="61" width="25" height="3" rx="1.5" fill="white" opacity="0.35"/>
      <rect x="60" y="68" width="20" height="3" rx="1.5" fill="white" opacity="0.35"/>
      <circle cx="40" cy="12" r="10" fill="#6FCF97" opacity="0.3"/>
      <path d="M36 12L39 15L44 9" stroke="#2FA084" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    </svg>`,
  },
  {
    label: "DevOps & SysAdmin",
    desc: "Server stabil, backup teratur. Anda cukup pantau dashboard.",
    svg: `<svg viewBox="0 0 120 100" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="25" y="14" width="70" height="20" rx="4" fill="#2FA084" opacity="0.15" stroke="#2FA084" stroke-width="1.5"/>
      <circle cx="35" cy="24" r="3" fill="#6FCF97"/>
      <rect x="44" y="21" width="20" height="6" rx="3" fill="#2FA084" opacity="0.3"/>
      <rect x="68" y="21" width="6" height="6" rx="3" fill="#2FA084" opacity="0.3"/>
      <rect x="78" y="21" width="6" height="6" rx="3" fill="#2FA084" opacity="0.3"/>
      <rect x="25" y="38" width="70" height="20" rx="4" fill="#2FA084" opacity="0.15" stroke="#2FA084" stroke-width="1.5"/>
      <circle cx="35" cy="48" r="3" fill="#6FCF97"/>
      <rect x="44" y="45" width="20" height="6" rx="3" fill="#2FA084" opacity="0.3"/>
      <rect x="68" y="45" width="6" height="6" rx="3" fill="#2FA084" opacity="0.3"/>
      <rect x="78" y="45" width="6" height="6" rx="3" fill="#2FA084" opacity="0.3"/>
      <rect x="25" y="62" width="70" height="20" rx="4" fill="#2FA084" opacity="0.15" stroke="#2FA084" stroke-width="1.5"/>
      <circle cx="35" cy="72" r="3" fill="#6FCF97"/>
      <rect x="44" y="69" width="20" height="6" rx="3" fill="#2FA084" opacity="0.3"/>
      <rect x="68" y="69" width="6" height="6" rx="3" fill="#2FA084" opacity="0.3"/>
      <rect x="78" y="69" width="6" height="6" rx="3" fill="#2FA084" opacity="0.3"/>
      <path d="M12 62L12 76M8 72H16" stroke="#6FCF97" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M12 62C12 62 8 58 2 62" stroke="#2FA084" stroke-width="1.5" stroke-linecap="round"/>
      <path d="M12 76C12 76 8 80 2 76" stroke="#2FA084" stroke-width="1.5" stroke-linecap="round"/>
    </svg>`,
  },
];
---

<BaseLayout title={title} description={description}>
  <main>

    <!-- ===== HERO ===== -->
    <section class="relative overflow-hidden border-b-2 border-brand-600 bg-brand-50">
      <div class="absolute inset-0 bg-dots opacity-30" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-7xl gap-12 px-5 py-5 sm:px-6 lg:grid-cols-[1fr_1fr] lg:px-8 lg:py-12">
        <div class="flex flex-col justify-center">
          <span class="inline-block w-fit rounded-full bg-brand-600 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-white shadow-sm">
            Terukur & Terdokumentasi
          </span>
          <h1 class="mt-6 max-w-xl font-heading text-4xl font-extrabold leading-tight text-ink sm:text-5xl lg:text-[3.75rem]">
            Sistem digital yang terukur, terdokumentasi, dan bisa dirawat tanpa kami.
          </h1>
          <p class="mt-6 max-w-lg text-lg leading-8 text-muted">
            Kami tahu rasanya mewarisi sistem tanpa dokumentasi. Setiap proyek dikerjakan dengan tolok ukur yang jelas — Anda tahu apa yang kami lakukan, kenapa, dan bagaimana mengelolanya sendiri setelah selesai.
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
              <a href={whatsApp} target="_blank" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3.5 text-sm font-bold text-white shadow-md shadow-brand-600/30 transition-all hover:bg-brand-700 hover:shadow-lg hover:shadow-brand-600/40">
              Ceritakan Kebutuhan Anda
              <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/portofolio" class="inline-flex items-center gap-2 rounded-lg border-2 border-brand-600 bg-white px-6 py-3.5 text-sm font-semibold text-brand-700 transition-all hover:bg-brand-50 hover:text-brand-600">
              Lihat Portofolio
            </a>
          </div>
        </div>

        <div class="hidden lg:grid grid-cols-2 gap-4 content-center">
          {skills.map(({ label, desc, svg }) => (
            <div class="group rounded-xl border-2 border-brand-200 bg-white p-5 shadow-sm transition-all hover:border-brand-400 hover:shadow-md hover:-translate-y-0.5">
              <div class="mx-auto w-full max-w-[120px]" set:html={svg} />
              <p class="mt-3 text-center font-heading text-sm font-bold text-ink group-hover:text-brand-600 transition-colors">{label}</p>
              <p class="mt-1.5 text-center text-xs leading-5 text-muted">{desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== LAYANAN ===== -->
    <section class="mx-auto max-w-7xl px-5 py-24 sm:px-6 lg:px-8">
      <SectionHeading
        eyebrow="Apa yang Kami Kerjakan"
        title="Setiap layanan, standar yang sama — terukur, terdokumentasi, bisa dirawat."
        description="Dari konsultasi strategi sampai maintenance rutin. Setiap layanan mengikuti proses yang sama: analisis kebutuhan, implementasi terarah, dokumentasi lengkap. Anda selalu tahu apa yang dikerjakan dan bagaimana mengelolanya."
      />
      <div class="mt-14 grid gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {services.map((s) => (
          <ServiceCard title={s.data.title} summary={s.data.summary} category={s.data.category} icon={s.data.icon} href={`/layanan/${s.id}`} />
        ))}
      </div>
      <div class="mt-12 text-center">
        <a href="/layanan" class="inline-flex items-center gap-2 rounded-lg border-2 border-brand-600 bg-white px-5 py-2.5 text-sm font-semibold text-brand-700 transition-all hover:bg-brand-50 hover:text-brand-600">
                        Lihat Detail Layanan <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>

    <!-- ===== SOLUSI ===== -->
    <!-- <section class="border-y-2 border-brand-600 bg-surface py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <SectionHeading
          eyebrow="Solusi"
          title="Paket layanan untuk berbagai kebutuhan bisnis"
          description="Gabungan layanan yang disesuaikan dengan kebutuhan: percetakan digital, institusi pendidikan, perusahaan, atau organisasi."
        />
        <div class="mt-14 grid gap-8">
          {solutions.map((sol) => (
            <SolutionCard
              title={sol.data.title}
              eyebrow={sol.data.eyebrow}
              summary={sol.data.summary}
              services={sol.data.services}
              outcome={sol.data.outcome}
            />
          ))}
        </div>
        <div class="mt-12 text-center">
          <a href="/solusi" class="inline-flex items-center gap-2 rounded-lg border-2 border-brand-600 bg-white px-5 py-2.5 text-sm font-semibold text-brand-700 transition-all hover:bg-brand-50 hover:text-brand-600">
            Semua Solusi <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section> -->

    <!-- ===== KLIEN ===== -->
    <section class="bg-brand-100 py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <SectionHeading
          eyebrow="Dipercaya Oleh"
          title="Institusi dan bisnis yang sudah merasakan hasilnya."
          description="Dari pendidikan tinggi hingga percetakan digital — setiap klien mendapat standar yang sama: terukur, terdokumentasi, bisa dirawat."
        />

        <div class="mt-14">
          {clientCards.length <= 4 ? (
            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
              {clientCards.map(({ data, logoSrc }) => (
                <a href={`/klien/${data.slug}`} class="group rounded-xl border-2 border-brand-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 block">
                  {logoSrc && <img src={logoSrc} alt={`Logo ${data.name}`} class="h-14 w-auto mb-4 object-contain" loading="lazy" />}
                  <span class="inline-block rounded-full bg-brand-100 px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.1em] text-brand-700">{data.category}</span>
                  <h3 class="mt-3 font-heading text-lg font-bold text-ink group-hover:text-brand-600 transition-colors">{data.name}</h3>
                  {data.testimonial && (
                    <p class="mt-3 text-sm leading-7 text-muted line-clamp-3 italic">"{data.testimonial}"</p>
                  )}
                </a>
              ))}
            </div>
          ) : (
            <>
              <div id="klien-track" class="flex gap-5 overflow-x-auto snap-x snap-mandatory scroll-smooth [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden pb-4">
                {clientCards.map(({ data, logoSrc }) => (
                  <a href={`/klien/${data.slug}`} class="group shrink-0 w-[280px] sm:w-[320px] snap-start rounded-xl border-2 border-brand-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-brand-500 block">
                    {logoSrc && <img src={logoSrc} alt={`Logo ${data.name}`} class="h-14 w-auto mb-4 object-contain" loading="lazy" />}
                    <span class="inline-block rounded-full bg-brand-100 px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.1em] text-brand-700">{data.category}</span>
                    <h3 class="mt-3 font-heading text-lg font-bold text-ink group-hover:text-brand-600 transition-colors">{data.name}</h3>
                    {data.testimonial && (
                      <p class="mt-3 text-sm leading-7 text-muted line-clamp-3 italic">"{data.testimonial}"</p>
                    )}
                  </a>
                ))}
              </div>
              <div class="flex justify-center gap-3 mt-8">
                <button type="button" id="klien-prev" class="grid size-10 place-items-center rounded-full border-2 border-brand-300 bg-white text-brand-600 hover:bg-brand-50 transition-colors" aria-label="Sebelumnya">
                  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
                </button>
                <button type="button" id="klien-next" class="grid size-10 place-items-center rounded-full border-2 border-brand-300 bg-white text-brand-600 hover:bg-brand-50 transition-colors" aria-label="Selanjutnya">
                  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/></svg>
                </button>
              </div>
            </>
          )}
        </div>
      </div>
    </section>

    {clientCards.length > 4 && (
      <script>
        (() => {
          const track = document.getElementById("klien-track");
          const prev = document.getElementById("klien-prev");
          const next = document.getElementById("klien-next");
          const w = 304;

          prev?.addEventListener("click", () => track?.scrollBy({ left: -w, behavior: "smooth" }));
          next?.addEventListener("click", () => track?.scrollBy({ left: w, behavior: "smooth" }));

          let auto = setInterval(() => {
            if (!track) return;
            if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 8) {
              track.scrollTo({ left: 0, behavior: "smooth" });
            } else {
              track.scrollBy({ left: w, behavior: "smooth" });
            }
          }, 4000);

          const pause = () => { clearInterval(auto); };
          const resume = () => { clearInterval(auto); auto = setInterval(() => {
            if (!track) return;
            if (track.scrollLeft + track.clientWidth >= track.scrollWidth - 8) {
              track.scrollTo({ left: 0, behavior: "smooth" });
            } else {
              track.scrollBy({ left: w, behavior: "smooth" });
            }
          }, 4000); };

          track?.addEventListener("mouseenter", pause);
          track?.addEventListener("mouseleave", resume);
          track?.addEventListener("touchstart", pause);
          track?.addEventListener("touchend", resume);
        })();
      </script>
    )}

    <!-- ===== PORTFOLIO ===== -->
    <section class="bg-white py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <SectionHeading
        eyebrow="Hasil Kerja"
        title="Bukan sekadar janji — ini yang sudah kami kerjakan."
        description="Setiap project diceritakan dari awal sampai akhir: masalah, tindakan, teknologi, dan hasil terukur. Karena bukti lebih keras daripada kata-kata."
        />
        <div class="mt-14 grid gap-6 lg:grid-cols-2">
          {portofolio.map((item) => (
            <PortofolioCard
              title={item.data.title}
              client={item.data.client}
              problem={item.data.problem}
              outcome={item.data.outcome}
              technologies={item.data.technologies}
              metrics={item.data.metrics}
              href={`/portofolio/${item.data.slug}`}
            />
          ))}
        </div>
        <div class="mt-12 text-center">
          <a href="/portofolio" class="inline-flex items-center gap-2 rounded-lg border-2 border-brand-600 bg-white px-5 py-2.5 text-sm font-semibold text-brand-700 transition-all hover:bg-brand-50 hover:text-brand-600">
                          Lihat Semua Portofolio <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
          </a>
        </div>
      </div>
    </section>

    <!-- ===== CARA KERJA ===== -->
    <section class="border-y-2 border-brand-600 bg-brand-50 py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <div class="mx-auto max-w-3xl text-center">
          <span class="inline-block rounded-full bg-brand-600 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-white shadow-sm">Cara Kerja</span>
          <h2 class="mt-5 font-heading text-3xl font-extrabold leading-tight text-ink sm:text-4xl">Dari analisis sampai dokumentasi</h2>
          <p class="mt-4 text-base leading-8 text-muted">Setiap proyek melewati tiga tahap: analisis, implementasi, dan validasi — memastikan hasil terukur.</p>
        </div>
        <div class="mt-16 grid gap-8 sm:grid-cols-3">
          <div class="relative text-center">
            <span class="inline-grid size-14 place-items-center rounded-full bg-brand-600 text-lg font-bold text-white shadow-lg shadow-brand-600/30">01</span>
            <h3 class="mt-6 font-heading text-xl font-bold text-ink">Analisis Kebutuhan</h3>
            <p class="mt-3 text-sm leading-7 text-muted">Kondisi sistem, akses teknis, dan prioritas dipetakan sebelum implementasi dimulai.</p>
            <div class="absolute top-7 left-[65%] hidden h-0.5 w-[70%] bg-brand-500 sm:block" aria-hidden="true"></div>
          </div>
          <div class="relative text-center">
            <span class="inline-grid size-14 place-items-center rounded-full bg-brand-600 text-lg font-bold text-white shadow-lg shadow-brand-600/30">02</span>
            <h3 class="mt-6 font-heading text-xl font-bold text-ink">Implementasi Terarah</h3>
            <p class="mt-3 text-sm leading-7 text-muted">Pekerjaan dijalankan sesuai scope, dari instalasi hingga maintenance.</p>
            <div class="absolute top-7 left-[65%] hidden h-0.5 w-[70%] bg-brand-500 sm:block" aria-hidden="true"></div>
          </div>
          <div class="text-center">
            <span class="inline-grid size-14 place-items-center rounded-full bg-brand-600 text-lg font-bold text-white shadow-lg shadow-brand-600/30">03</span>
            <h3 class="mt-6 font-heading text-xl font-bold text-ink">Validasi & Dokumentasi</h3>
            <p class="mt-3 text-sm leading-7 text-muted">Fungsi utama diverifikasi dan catatan teknis disiapkan untuk pengelolaan lanjutan.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== PRODUK ===== -->
    {products.length > 0 && (
      <section class="bg-white py-20">
        <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
          <div class="mx-auto max-w-3xl text-center">
            <span class="inline-block rounded-full bg-brand-600 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-white shadow-sm">Juga Produk Kami</span>
            <h2 class="mt-5 font-heading text-3xl font-extrabold leading-tight text-ink sm:text-4xl">Tools & aplikasi yang bisa langsung Anda pakai</h2>
            <p class="mt-4 text-base leading-8 text-muted">Dikembangkan berdasarkan kebutuhan nyata — bukan sekadar portofolio, tapi produk yang berjalan di production.</p>
          </div>
          <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
            {products.map((p) => (
              <a href={`/produk/${p.data.slug}`} class="group block rounded-xl border-2 border-line bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-brand-500">
                <span class="inline-block rounded-full bg-brand-600 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-white shadow-sm">{p.data.status === "available" ? "Tersedia" : "Segera Hadir"}</span>
                <h3 class="mt-4 font-heading text-xl font-bold text-ink group-hover:text-brand-600 transition-colors">{p.data.title}</h3>
                <p class="mt-3 text-sm leading-7 text-muted line-clamp-2">{p.data.summary}</p>
                <span class="mt-3 inline-block text-sm font-semibold text-brand-600">Lihat detail &rarr;</span>
              </a>
            ))}
          </div>
          <div class="mt-10 text-center">
            <a href="/produk" class="inline-flex items-center gap-2 rounded-lg border-2 border-brand-600 bg-white px-5 py-2.5 text-sm font-semibold text-brand-700 transition-all hover:bg-brand-50 hover:text-brand-600">
              Lihat Semua Produk <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </section>
    )}

    <!-- ===== CTA ===== -->
    <section class="bg-asphalt px-5 py-24 sm:px-6 lg:px-8">
      <div class="mx-auto flex max-w-4xl flex-col items-center text-center gap-8">
        <span class="inline-block rounded-full bg-surface-alt px-4 py-1.5 text-lg font-bold uppercase tracking-[0.14em] text-brand-900 shadow-md">Siap Memulai?</span>
        <h2 class="font-heading text-3xl font-extrabold leading-tight text-white sm:text-4xl lg:text-5xl">
          Ceritakan kebutuhan Anda — kami bantu arahkan solusi yang terukur, terdokumentasi, dan bisa Anda kelola sendiri.
        </h2>
        <p class="max-w-2xl text-lg leading-8 text-white">
          Konsultasi awal gratis, tanpa komitmen. Anda tinggal cerita masalahnya, kami bantu tentukan langkah teknis yang paling masuk akal.
        </p>
        <a href={whatsApp} target="_blank" class="inline-flex items-center gap-2 rounded-lg bg-accent px-8 py-4 text-base font-bold text-ink shadow-lg shadow-accent/30 transition-all hover:bg-surface-alt hover:text-emerald-800 hover:shadow-xl hover:shadow-accent/50">
            Ceritakan Kebutuhan Anda
          <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
