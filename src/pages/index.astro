---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PortofolioCard from "@/components/PortofolioCard.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import SolutionCard from "@/components/SolutionCard.astro";
import { byOrder, featured } from "@/lib/content";

const services = featured(await getCollection("services")).slice(0, 6).filter((p) => p.data.is_published !== false);
const solutions = featured(await getCollection("solutions"));
const clients = featured(await getCollection("clients"));
const portfolio = featured(await getCollection("portofolio")).slice(0, 4);

const title = "Motekar Teknologi Indonesia \u2014 IT Consultant, Web Development, DevOps & QA";
const description = "Motekar Teknologi Indonesia menyediakan layanan IT consultant, web development, DevOps, QA, dan solusi digital untuk bisnis dan organisasi.";
