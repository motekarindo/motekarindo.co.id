---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { byOrder, featured, serviceName } from "@/lib/content";
import { site } from "@/lib/site.data";

const services = featured(await getCollection("services")).filter((p) => p.data.is_published === true).slice(0, 5);
const clients = featured(await getCollection("clients")).filter((p) => p.data.is_published === true);

const logoList = import.meta.glob("/src/assets/images/klien/**/*.{jpg,jpeg,png,webp,avif}");

const clientCards: { data: (typeof clients)[number]["data"]; logoSrc?: string }[] = [];
for (const client of byOrder(clients)) {
  let logoSrc: string | undefined;
  if (client.data.logo) {
    for (const [path, loader] of Object.entries(logoList)) {
      if (path.endsWith("/" + client.data.logo)) {
        const m: any = await loader();
        logoSrc = m.default.src;
        break;
      }
    }
  }
  clientCards.push({ data: client.data, logoSrc });
}

const portofolio = featured(await getCollection("portofolio")).filter((p) => p.data.is_published === true).slice(0, 4);
const products = (await getCollection("products")).filter((p) => p.data.is_published === true);

const title = "Motekar Teknologi Indonesia \u2014 Sistem Digital Terukur & Terdokumentasi";
const description = "Jasa IT dengan dokumentasi lengkap: web development, DevOps, QA, dan maintenance server. Terukur, terdokumentasi, bisa dirawat sendiri.";
const whatsApp = `https://wa.me/${site.whatsApp}?text=Halo%20*Motekarindo*.%20Saya%20ingin%20konsultasi.`;
// Lebih dari 6 klien → strip logo berjalan (marquee). 6 atau kurang → satu baris statis.
const useMarquee = clientCards.length > 6;
// Satu putaran marquee diulang sampai ±14 logo supaya selalu lebih lebar dari baris (tidak ada celah kosong).
const marqueeUnit = Array.from({ length: Math.ceil(14 / Math.max(clientCards.length, 1)) }, () => clientCards).flat();
const testimonials = clientCards.filter((c) => c.data.testimonial);

// Isi panel hero: yang klien terima dari paket pemeliharaan (bukan data klien).
const deliverables = [
  { title: "Monitoring server", desc: "Uptime dan resource dipantau terus", tag: "24/7" },
  { title: "Backup otomatis", desc: "Diuji restore, bukan sekadar disimpan", tag: "Harian" },
  { title: "Respons insiden", desc: "Langsung ditangani engineer", tag: "Siaga" },
  { title: "Laporan pemeliharaan", desc: "Kondisi sistem dan tindakan yang diambil", tag: "Bulanan" },
  { title: "Dokumentasi sistem", desc: "Diserahkan ke Anda, bukan disimpan sendiri", tag: "Lengkap" },
];

// Tabel studi kasus: pekerjaan + hasil saja (kondisi "sebelum" klien tidak ditampilkan). Hasil = field `highlight`, fallback metrik angka.
const cases = portofolio.map((item) => {
  const d = item.data;
  const numeric = (d.metrics ?? []).find((m) => /\d/.test(m.value));
  return {
    href: `/portofolio/${d.slug}`,
    client: d.client,
    work: d.title.split(/\s+—\s+/)[0],
    result: d.highlight
      ? { value: "", label: d.highlight }
      : numeric ? { value: numeric.value, label: numeric.label.toLowerCase() } : { value: "", label: d.outcome.split(/\s+—\s+|\.\s/)[0] },
  };
});

const steps = [
  { title: "Analisis kebutuhan", out: "Catatan kebutuhan", desc: "Kondisi sistem, akses teknis, dan prioritas dipetakan sebelum implementasi dimulai." },
  { title: "Implementasi terarah", out: "Progres terpantau", desc: "Pekerjaan dijalankan sesuai scope, dari instalasi hingga maintenance, dengan progres yang bisa Anda pantau." },
  { title: "Validasi & serah terima", out: "Dokumen serah terima", desc: "Fungsi utama diverifikasi dan catatan teknis diserahkan untuk pengelolaan lanjutan." },
];
---

<BaseLayout title={title} description={description}>
  <main>

    <!-- ===== HERO ===== -->
    <section class="bg-grid">
      <div class="mx-auto grid max-w-7xl gap-14 px-5 pb-20 pt-16 sm:px-6 lg:grid-cols-[1.15fr_1fr] lg:items-center lg:gap-16 lg:px-8 lg:pb-24 lg:pt-24">
        <div>
          <p class="eyebrow text-sm font-semibold uppercase tracking-[0.06em] text-brand-700">Tim IT · Bogor, Jawa Barat</p>
          <h1 class="mt-5 font-heading text-4xl font-extrabold leading-[1.05] tracking-[-0.035em] text-ink sm:text-5xl lg:text-[3.5rem]">
            Sistem IT yang dikerjakan rapi, dan <span class="mark-hl">bisa dirawat siapa pun</span>.
          </h1>
          <p class="mt-7 max-w-xl text-lg leading-8 text-muted">
            Kami membangun dan merawat server, aplikasi, dan website untuk instansi, kampus, dan bisnis. Setiap pekerjaan terdokumentasi dan diserahkan ke Anda.
          </p>
          <div class="mt-9 flex flex-wrap gap-3">
            <a href={whatsApp} target="_blank" rel="noopener" class="inline-flex min-h-13 items-center gap-2 rounded-lg bg-brand-600 px-6 font-semibold text-white transition-colors hover:bg-brand-700">
              Ceritakan Kebutuhan Anda <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
            </a>
            <a href="/portofolio" class="inline-flex min-h-13 items-center rounded-lg border border-ink bg-white px-6 font-semibold text-ink transition-colors hover:bg-ink hover:text-white">
              Lihat Studi Kasus
            </a>
          </div>
          <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2 text-sm font-medium text-muted">
            {["Konsultasi awal gratis", "Bisa tatap muka di Bogor", "Melayani seluruh Indonesia"].map((t) => (
              <li class="flex items-center gap-2"><span class="font-bold text-brand-600" aria-hidden="true">✓</span>{t}</li>
            ))}
          </ul>
        </div>

        <div class="relative">
          <span class="absolute -left-2.5 -top-3 text-lg leading-none text-soft/60" aria-hidden="true">+</span>
          <span class="absolute -bottom-3 -right-2.5 text-lg leading-none text-soft/60" aria-hidden="true">+</span>
          <div class="overflow-hidden rounded-xl border border-line bg-white shadow-[0_24px_48px_-32px_rgba(15,26,22,.28)]">
            <div class="flex items-center justify-between gap-3 border-b border-line bg-surface-alt px-5 py-3.5 text-xs font-semibold uppercase tracking-[0.05em] text-soft">
              <span>Paket pemeliharaan</span><span>Yang Anda terima</span>
            </div>
            <ul>
              {deliverables.map((d) => (
                <li class="flex items-center gap-4 border-b border-grid px-5 py-4">
                  <span class="size-2.5 shrink-0 rounded-full bg-signal ring-4 ring-highlight" aria-hidden="true"></span>
                  <span class="min-w-0 flex-1">
                    <span class="block font-bold text-ink">{d.title}</span>
                    <span class="mt-0.5 block text-sm text-soft">{d.desc}</span>
                  </span>
                  <span class="shrink-0 rounded-md bg-highlight px-2 py-1 text-[11px] font-bold uppercase tracking-[0.06em] text-brand-700">{d.tag}</span>
                </li>
              ))}
            </ul>
            <p class="px-5 py-3.5 text-sm text-soft">+ Akses penuh tetap di tangan Anda — tidak dikunci vendor.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- ===== KLIEN ===== -->
    {clientCards.length > 0 && (
      <section aria-labelledby="klien-label" class="border-y border-line">
        <div class={`relative mx-auto flex max-w-7xl flex-col gap-4 px-5 py-7 sm:px-6 md:flex-row md:items-center md:gap-12 lg:px-8 ${useMarquee ? "md:block" : ""}`}>
          <p
            id="klien-label"
            class={`shrink-0 text-sm font-medium text-soft ${useMarquee ? "relative z-10 md:absolute md:inset-y-0 md:left-0 md:flex md:items-center md:bg-white md:pl-6 md:pr-16 lg:pl-8 md:[mask-image:linear-gradient(to_right,#000_calc(100%-3rem),transparent)]" : ""}`}
          >Dipercaya oleh</p>
          {useMarquee ? (
            <div class="marquee min-w-0 overflow-hidden">
              <div class="marquee-track flex w-max">
                {[0, 1].map((copy) => (
                  <ul class="flex shrink-0 items-center gap-12 pr-12" aria-hidden={copy === 1 ? "true" : undefined}>
                    {marqueeUnit.map(({ data, logoSrc }, i) => {
                      const dup = copy === 1 || i >= clientCards.length;
                      return (
                      <li class="flex shrink-0 items-center" aria-hidden={dup && copy === 0 ? "true" : undefined}>
                        <a href={`/klien/${data.slug}`} title={data.name} tabindex={dup ? -1 : undefined} class="block opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0">
                          {logoSrc
                            ? <img src={logoSrc} alt={dup ? "" : data.name} class="h-11 w-auto object-contain" loading="lazy" />
                            : <span class="whitespace-nowrap text-[15px] font-semibold text-muted">{data.name}</span>}
                        </a>
                      </li>
                      );
                    })}
                  </ul>
                ))}
              </div>
            </div>
          ) : (
            <ul class="-mx-5 flex snap-x scroll-px-5 items-center gap-12 overflow-x-auto px-5 [scrollbar-width:none] md:mx-0 md:overflow-visible md:px-0 [&::-webkit-scrollbar]:hidden">
              {clientCards.map(({ data, logoSrc }) => (
                <li class="flex shrink-0 snap-start items-center">
                  <a href={`/klien/${data.slug}`} title={data.name} class="block opacity-70 grayscale transition hover:opacity-100 hover:grayscale-0">
                    {logoSrc
                      ? <img src={logoSrc} alt={data.name} class="h-11 w-auto object-contain" loading="lazy" />
                      : <span class="whitespace-nowrap text-[15px] font-semibold text-muted">{data.name}</span>}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )}

    <!-- ===== LAYANAN (bento) ===== -->
    <section class="bg-grid">
      <div class="mx-auto max-w-7xl px-5 py-24 sm:px-6 lg:px-8 lg:py-28">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <SectionHeading eyebrow="Layanan" title="Layanan untuk sistem yang harus terus berjalan" />
          <a href="/layanan" class="inline-flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-800">Semua layanan <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>
        <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {services.map((s, i) => (
            <a
              href={`/layanan/${s.data.slug}`}
              class={`group flex flex-col gap-3 rounded-xl border bg-white p-7 transition-colors ${i === 0 ? "border-ink sm:col-span-2 lg:p-9" : "border-line hover:border-ink"}`}
            >
              <span class="text-xs font-semibold uppercase tracking-[0.06em] text-soft">{String(i + 1).padStart(2, "0")}</span>
              <span class={`font-heading font-bold tracking-[-0.02em] text-ink group-hover:text-brand-700 ${i === 0 ? "text-3xl font-extrabold" : "text-xl"}`}>{serviceName(s.data.title)}</span>
              <span class={`leading-7 text-muted ${i === 0 ? "max-w-xl text-base" : "text-[15px] line-clamp-3"}`}>{s.data.summary}</span>
              {i === 0 && <span class="mt-auto inline-flex items-center gap-1.5 pt-4 text-sm font-semibold text-brand-700">Lihat layanan <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg></span>}
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- ===== STUDI KASUS (tabel) ===== -->
    <section class="border-y border-line bg-white">
      <div class="mx-auto max-w-7xl px-5 py-24 sm:px-6 lg:px-8 lg:py-28">
        <div class="flex flex-wrap items-end justify-between gap-6">
          <SectionHeading eyebrow="Studi kasus" title="Hasil yang bisa dicek." />
          <a href="/portofolio" class="inline-flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-800">Semua portofolio <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        </div>
        <div class="mt-12 border-t border-ink">
          <div class="hidden grid-cols-[1fr_1.6fr_1.2fr_2rem] gap-6 border-b border-line py-3.5 text-xs font-semibold uppercase tracking-[0.06em] text-soft md:grid">
            <span>Klien</span><span>Pekerjaan</span><span>Hasil</span><span></span>
          </div>
          <ul>
            {cases.map((c) => (
              <li>
                <a href={c.href} class="group grid gap-1.5 border-b border-line py-6 md:grid-cols-[1fr_1.6fr_1.2fr_2rem] md:items-center md:gap-6">
                  <span class="text-sm font-semibold text-soft md:text-base md:text-ink">{c.client}</span>
                  <span class="font-semibold text-ink group-hover:text-brand-700 md:font-normal md:text-muted">{c.work}</span>
                  <span class="text-brand-700">
                    {c.result.value && <strong class="font-heading text-lg font-extrabold">{c.result.value} </strong>}
                    <span class={`text-[15px] ${c.result.value ? "" : "font-semibold"}`}>{c.result.label}</span>
                  </span>
                  <span class="hidden text-xl text-ink transition-transform group-hover:translate-x-1 md:block" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- ===== TESTIMONI ===== -->
    {testimonials.length > 0 && (
      <section class="mx-auto max-w-7xl px-5 py-24 sm:px-6 lg:px-8 lg:py-28">
        <SectionHeading eyebrow="Kata klien" title="Dari mereka yang sistemnya kami rawat" />
        <div class="mt-12 grid gap-6 md:grid-cols-2">
          {testimonials.map(({ data, logoSrc }) => (
            <figure class="flex flex-col justify-between gap-8 rounded-2xl border border-line p-8">
              <blockquote class="text-lg leading-8 text-ink">“{data.testimonial}”</blockquote>
              <figcaption class="flex items-center gap-4">
                {logoSrc && <img src={logoSrc} alt="" class="h-10 w-auto object-contain" loading="lazy" />}
                <span>
                  <a href={`/klien/${data.slug}`} class="block font-semibold text-ink hover:text-brand-700">{data.name}</a>
                  {data.location && <span class="text-sm text-soft">{data.location}</span>}
                </span>
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- ===== CARA KERJA ===== -->
    <section class="bg-grid border-t border-line">
      <div class="mx-auto max-w-7xl px-5 py-24 sm:px-6 lg:px-8 lg:py-28">
        <SectionHeading eyebrow="Cara kerja" title="Tiga tahap, semuanya terdokumentasi." />
        <ol class="mt-12 grid overflow-hidden rounded-xl border border-ink bg-white sm:grid-cols-3">
          {steps.map((st, i) => (
            <li class="flex flex-col gap-3 border-line p-7 not-last:border-b sm:not-last:border-b-0 sm:not-last:border-r lg:p-8">
              <div class="flex items-center gap-3 text-xs font-semibold uppercase tracking-[0.05em] text-soft">
                <span class="inline-flex size-7 shrink-0 items-center justify-center rounded-full border-[1.5px] border-brand-600 text-brand-700">{i + 1}</span>
                <span class="h-px flex-1 bg-[linear-gradient(90deg,var(--color-soft)_50%,transparent_50%)] bg-[length:8px_1px] opacity-50" aria-hidden="true"></span>
                <span>{st.out}</span>
              </div>
              <h3 class="mt-2 font-heading text-xl font-bold text-ink">{st.title}</h3>
              <p class="text-[15px] leading-7 text-muted">{st.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- ===== PRODUK ===== -->
    {products.length > 0 && (
      <section class="border-t border-line bg-surface-alt">
        <div class="mx-auto max-w-7xl px-5 py-24 sm:px-6 lg:px-8">
          <div class="flex flex-wrap items-end justify-between gap-6">
            <SectionHeading eyebrow="Produk" title="Tools & aplikasi yang bisa langsung Anda pakai" />
            <a href="/produk" class="inline-flex items-center gap-1.5 font-semibold text-brand-700 hover:text-brand-800">Semua produk <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg></a>
          </div>
          <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {products.map((p) => (
              <a href={`/produk/${p.data.slug}`} class="group block rounded-2xl border border-line bg-white p-7 transition-colors hover:border-brand-600">
                <p class="text-sm font-semibold text-soft">{p.data.status === "available" ? "Tersedia" : "Segera hadir"}</p>
                <h3 class="mt-2 font-heading text-xl font-bold text-ink group-hover:text-brand-700">{p.data.title}</h3>
                <p class="mt-2 text-[15px] leading-7 text-muted line-clamp-2">{p.data.summary}</p>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- ===== CTA ===== -->
    <section class="bg-asphalt text-white">
      <div class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-10 px-5 py-20 sm:px-6 lg:px-8 lg:py-24">
        <div class="max-w-2xl">
          <h2 class="font-heading text-3xl font-extrabold leading-[1.15] tracking-[-0.03em] sm:text-4xl">Konsultasi awal gratis, tanpa komitmen.</h2>
          <p class="mt-4 text-lg leading-8 text-neutral-300">Ceritakan masalahnya, kami bantu tentukan langkah teknis yang paling masuk akal.</p>
          <p class="mt-4 text-[15px] text-neutral-400">{site.address}</p>
        </div>
        <a href={whatsApp} target="_blank" rel="noopener" class="inline-flex min-h-13 items-center gap-2 rounded-lg bg-brand-600 px-7 font-semibold text-white transition-colors hover:bg-brand-500">
          Chat WhatsApp <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>

  </main>
</BaseLayout>
