---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import { byOrder, statusLabel } from "@/lib/content";
import { site } from "@/lib/site.data";

const products = byOrder(await getCollection("products")).filter((p) => p.data.is_published !== false);
const title = "Produk \u2014 Tools & Aplikasi Bisnis | Motekarindo";
const description = "Produk digital Motekarindo: POS Percetakan untuk manajemen operasional dan Privacy PDF untuk PDF tools gratis tanpa upload langsung di browser.";
const waApp = `https://wa.me/${site.whatsApp}?text=Halo%20*Motekarindo*.%20Saya%20butuh%20aplikasi%20khusus.`;
---

<BaseLayout title={title} description={description}>
  <main>
    <PageHero eyebrow="Produk" title="Produk digital untuk operasional bisnis" description="Aplikasi yang kami kembangkan dari kebutuhan nyata klien — dari POS untuk percetakan digital sampai PDF tools gratis yang berjalan di browser." />
    <section class="mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid gap-6 lg:grid-cols-2">
        {products.map((p) => (
          <a href={`/produk/${p.data.slug}`} class="block group rounded-2xl border border-line bg-white p-8 transition-colors hover:border-brand-600">
            <p class="text-sm font-semibold text-soft">{statusLabel(p.data.status)}</p>
            <h2 class="mt-2 font-heading text-2xl font-bold text-ink group-hover:text-brand-700 transition-colors">{p.data.title}</h2>
            <p class="mt-3 text-[15px] leading-7 text-muted">{p.data.summary}</p>
            <p class="mt-5 border-t border-line pt-4 text-sm leading-7 text-muted"><span class="font-semibold text-ink">Untuk:</span> {p.data.audience}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-asphalt px-5 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto flex max-w-3xl flex-col items-center text-center gap-6">
        <h2 class="font-heading text-3xl font-extrabold text-white sm:text-4xl">Butuh aplikasi khusus?</h2>
        <p class="text-lg leading-8 text-neutral-300">Ceritakan kebutuhan Anda — kami bantu rancang scope dan arsitektur aplikasi yang sesuai, tanpa biaya konsultasi awal.</p>
        <a href={waApp} target="_blank" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-8 py-4 text-base font-bold text-white transition-all hover:bg-brand-500">
          Ceritakan Kebutuhan Anda
          <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
