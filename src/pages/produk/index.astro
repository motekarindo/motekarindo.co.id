---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import { byOrder, statusLabel } from "@/lib/content";
import { site } from "@/lib/site.data";

const products = byOrder(await getCollection("products")).filter((p) => p.data.is_published !== false);
const title = "Produk \u2014 Tools & Aplikasi Bisnis | Motekar";
const description = "Produk digital dari Motekar: POS Percetakan untuk manajemen operasional, Privacy PDF untuk tools dokumen gratis, dan aplikasi bisnis custom.";
const waApp = `https://wa.me/${site.whatsApp}?text=Halo%20*Motekarindo*.%20Saya%20butuh%20aplikasi%20khusus.`;
---

<BaseLayout title={title} description={description}>
  <main>
    <PageHero eyebrow="Produk" title="Produk digital untuk operasional bisnis" description="Produk dikembangkan berdasarkan kebutuhan nyata — dimulai dari ERP untuk operasional percetakan digital." />
    <section class="mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid gap-6 lg:grid-cols-2">
        {products.map((p) => (
          <a href={`/produk/${p.data.slug}`} class="block group rounded-xl border-2 border-line bg-white p-8 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-brand-500">
            <span class="inline-block rounded-full bg-brand-600 px-3 py-1 text-xs font-bold uppercase tracking-[0.12em] text-white shadow-sm">{statusLabel(p.data.status)}</span>
            <h2 class="mt-5 font-heading text-2xl font-bold text-ink group-hover:text-brand-600 transition-colors">{p.data.title}</h2>
            <p class="mt-3 text-sm leading-7 text-muted">{p.data.summary}</p>
            <p class="mt-5 rounded-lg bg-brand-50 p-4 text-sm font-semibold leading-7 text-brand-800">Untuk: {p.data.audience}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="bg-asphalt px-5 py-20 sm:px-6 lg:px-8">
      <div class="mx-auto flex max-w-3xl flex-col items-center text-center gap-6">
        <h2 class="font-heading text-3xl font-extrabold text-white sm:text-4xl">Butuh aplikasi khusus?</h2>
        <p class="text-lg leading-8 text-white">Ceritakan kebutuhan Anda — kami bantu rancang scope dan arsitektur aplikasi yang sesuai, tanpa biaya konsultasi awal.</p>
        <a href={waApp} target="_blank" class="inline-flex items-center gap-2 rounded-lg bg-accent px-8 py-4 text-base font-bold text-ink shadow-lg shadow-accent/30 transition-all hover:bg-surface-alt hover:text-emerald-800 hover:shadow-xl hover:shadow-accent/50">
          Ceritakan Kebutuhan Anda
          <svg class="size-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
