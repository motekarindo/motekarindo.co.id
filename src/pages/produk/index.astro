---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import { byOrder, statusLabel } from "@/lib/content";

const products = byOrder(await getCollection("products")).filter((p) => p.data.is_published !== false);
const title = "Produk \u2014 Tools & Aplikasi Bisnis | Motekar";
const description = "Produk digital dari Motekar: ERP percetakan, custom application, dan solusi bisnis.";
