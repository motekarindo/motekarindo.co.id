---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { byOrder } from "@/lib/content";
import ServiceIllustration from "@/components/ServiceIllustration.astro";
import ImageGallery from "@/components/ImageGallery.astro";
import { site } from "@/lib/site.data";
import { cities } from "@/lib/cities";

export async function getStaticPaths() {
  const items = await getCollection("products");
  return items
    .filter((i) => i.data.is_published !== false)
    .map((item) => ({ params: { slug: item.data.slug } }));
}

const { slug } = Astro.params;
const mdFiles = import.meta.glob("/src/content/produk/*.md");

let mod: any;
for (const [, loader] of Object.entries(mdFiles)) {
  const m = await loader();
  if (m.frontmatter.slug === slug) {
    mod = m;
    break;
  }
}

if (!mod) {
  return Astro.redirect("/produk", 302);
}

const Content = mod.Content;
const fm = mod.frontmatter;

if (fm.is_published === false) {
  return Astro.redirect("/produk", 302);
}

const allProducts = byOrder(await getCollection("products"));
const related = allProducts.filter((p) => p.data.is_published !== false && p.data.slug !== slug).slice(0, 3);

const bodyImages = import.meta.glob("/src/assets/images/produk/**/*.{jpg,jpeg,png,webp,avif}");

const images = import.meta.glob<{ default: { src: string; width: number; height: number } }>(
  "/src/assets/images/produk/**/*.{jpg,jpeg,png,webp,avif}"
);

let heroImage: { src: string; width: number; height: number } | undefined;
if (fm.image?.file) {
  const match = Object.entries(images).find(([path]) => path.endsWith("/" + fm.image.file));
  if (match) {
    const resolved = await match[1]();
    heroImage = resolved.default;
  }
}
const heroAlt = fm.image?.alt ?? fm.title;

const raw = mod.rawContent?.() ?? "";
const faqSection = raw.split("### FAQ")[1] ?? "";
const faqItems: { question: string; answer: string }[] = [];
if (faqSection) {
  const qaRegex = /\*\*(.+?)\?\*\*\s*\n([\s\S]*?)(?=\n\*\*|\n###|\n$|$)/g;
  let m;
  while ((m = qaRegex.exec(faqSection)) !== null) {
    faqItems.push({ question: m[1].trim() + "?", answer: m[2].trim().replace(/\n/g, " ") });
  }
}
const faqSchema = faqItems.length > 0 ? JSON.stringify({ "@context": "https://schema.org", "@type": "FAQPage", mainEntity: faqItems.map((q) => ({ "@type": "Question", name: q.question, acceptedAnswer: { "@type": "Answer", text: q.answer } })) }) : "";

const whatsappBase = `https://wa.me/${site.whatsApp}?text=`;
const linkHost = fm.link ? new URL(fm.link).hostname.replace(/^www\./, "") : "";
const waHero = whatsappBase + encodeURIComponent("Halo Motekarindo, saya tertarik dengan produk " + fm.title);
const waSidebar = whatsappBase + encodeURIComponent("Halo Motekarindo, saya tertarik dengan produk " + fm.title);
const waBottom = whatsappBase + encodeURIComponent("Halo Motekarindo, saya ingin info lebih lanjut tentang " + fm.title);

const statusLabel = fm.status === "in-development" ? "Dalam Pengembangan" : fm.status === "coming-soon" ? "Segera Hadir" : fm.status === "available" ? "Tersedia" : fm.status;
const featuredCities = cities.filter((city) => ["bogor", "jakarta-pusat", "bandung", "depok", "bekasi", "tangerang", "surabaya", "yogyakarta"].includes(city.slug));
---

<BaseLayout
  title={`${fm.title} | Motekarindo`}
  description={fm.description ?? fm.summary ?? ""}
>
  <main>
    <nav class="border-b border-line bg-white" aria-label="Breadcrumb">
      <ol class="mx-auto flex max-w-7xl items-center gap-1.5 px-5 py-3 text-sm text-soft sm:px-6 lg:px-8">
        <li><a href="/" class="transition-colors hover:text-brand-600">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/produk" class="transition-colors hover:text-brand-600">Produk</a></li>
        <li aria-hidden="true">/</li>
        <li class="truncate text-ink" aria-current="page">{fm.title}</li>
      </ol>
    </nav>

    <section class="bg-grid relative overflow-hidden border-b border-line">
      <div class="relative mx-auto grid max-w-7xl gap-10 px-5 py-5 sm:px-6 sm:py-22 lg:grid-cols-2 lg:items-center lg:px-8 lg:py-10">
        <div>
          <div class="flex items-center gap-3">
            <span class="inline-block eyebrow text-sm font-semibold uppercase tracking-[0.06em] text-brand-700">
              {fm.category ?? "Produk"}
            </span>
            <span class="text-sm text-soft">· {statusLabel}</span>
          </div>
          <h1 class="mt-5 font-heading text-4xl font-extrabold leading-[1.08] tracking-[-0.03em] text-ink sm:text-5xl">
            {fm.title}
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-muted">{fm.description ?? fm.summary}</p>
          <p class="mt-4 max-w-xl text-[15px] text-muted"><span class="font-semibold text-ink">Untuk:</span> {fm.audience}</p>
          <div class="mt-8 flex flex-wrap gap-4">
            {fm.link ? (
              <>
                <a href={fm.link} target="_blank" rel="noopener" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 font-heading text-base font-semibold text-white transition-colors hover:bg-brand-700">
                  Buka {linkHost}
                  <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M7 17L17 7M9 7h8v8"/></svg>
                </a>
                <a href={waHero} class="inline-flex items-center gap-2 rounded-lg border border-line px-6 py-3 font-heading text-base font-semibold text-ink transition-colors hover:border-ink">
              <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Tanya via WhatsApp
            </a>
              </>
            ) : (
            <a href={waHero} class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3 font-heading text-base font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-md">
              <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Chat WhatsApp
            </a>
            )}
          </div>
        </div>
        <div class="lg:min-h-[400px]">
          {heroImage ? (
            <img src={heroImage.src} width={heroImage.width} height={heroImage.height} alt={heroAlt} sizes="(max-width: 1024px) 100vw, 624px" class="h-auto w-full rounded-2xl shadow-xl" loading="eager" />
          ) : (
            <div class="flex h-full w-full items-center justify-center bg-brand-50 p-12">
              <ServiceIllustration icon={fm.icon} class="max-h-64 w-full max-w-xs" />
            </div>
          )}
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 lg:grid lg:grid-cols-12 lg:gap-12 lg:px-8 lg:py-24">
      <div class="lg:col-span-8">
        <article class="prose prose-lg max-w-none
          prose-headings:font-heading prose-headings:font-bold prose-headings:text-ink prose-headings:scroll-mt-24
          prose-h3:mt-12 prose-h3:mb-4 prose-h3:text-xl prose-h3:sm:text-2xl prose-h3:text-brand-700
          prose-p:text-muted prose-p:leading-8 prose-li:text-muted prose-li:leading-7 prose-li:marker:text-brand-500
          prose-strong:text-ink prose-strong:font-semibold prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline
        ">
          <Content />
        </article>

        {fm.gallery && fm.gallery.length > 0 && (
          <ImageGallery gallery={fm.gallery} />
        )}

        {fm.is_localization && (
          <section class="mt-16 border-t border-line pt-10">
            <h2 class="font-heading text-2xl font-bold text-ink">Demo dan implementasi di kota Anda</h2>
            <p class="mt-3 max-w-2xl leading-7 text-muted">Tim Motekarindo melayani konsultasi, demo, konfigurasi, dan pendampingan penggunaan {fm.title.split(" — ")[0]} secara remote maupun onsite sesuai kebutuhan.</p>
            <div class="mt-6 flex flex-wrap gap-3">
              {featuredCities.map((city) => (
                <a href={`/produk/${fm.slug}/${city.slug}`} class="rounded-full border border-brand-200 bg-brand-50 px-4 py-2 text-sm font-semibold text-brand-700 transition-colors hover:border-brand-500 hover:bg-brand-100">
                  {fm.title.split(" — ")[0]} di {city.name}
                </a>
              ))}
            </div>
          </section>
        )}

        {related.length > 0 && (
          <section class="mt-16 border-t border-line pt-10">
            <h3 class="font-heading text-lg font-bold text-ink mb-5">Baca juga</h3>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((p) => (
                <a href={`/produk/${p.data.slug}`} class="group rounded-xl border border-line bg-white p-5 transition-colors hover:border-brand-600">
                  <p class="font-heading text-sm font-bold text-ink group-hover:text-brand-600 transition-colors">{p.data.title}</p>
                  <p class="mt-1.5 text-xs leading-5 text-muted line-clamp-2">{p.data.summary}</p>
                  <span class="mt-3 inline-block text-xs font-semibold text-brand-600">Selengkapnya &rarr;</span>
                </a>
              ))}
            </div>
          </section>
        )}

        {faqSchema && (
          <script type="application/ld+json" set:html={faqSchema} />
        )}
      </div>

      <aside class="mt-16 lg:col-span-4 lg:mt-0">
        <div class="lg:sticky lg:top-28 space-y-8">
          <div class="rounded-2xl border border-line bg-surface-alt p-6">
            <h3 class="font-heading text-lg font-bold text-ink">Tertarik dengan produk ini?</h3>
            <p class="mt-2 text-sm leading-6 text-muted">Diskusikan kebutuhan Anda dengan tim kami. Konsultasi awal gratis, tanpa komitmen.</p>
            <a href={waSidebar} class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 py-3 text-center font-heading text-sm font-semibold text-white shadow-sm transition-all hover:bg-brand-700">
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Chat via WhatsApp
            </a>
          </div>
          {related.length > 0 && (
            <div>
              <h3 class="font-heading text-lg font-bold text-ink">Produk lainnya</h3>
              <div class="mt-4 space-y-3">
                {related.map((p) => (
                  <a href={`/produk/${p.data.slug}`} class="block rounded-xl border border-line bg-white p-4 transition-all hover:border-brand-200 hover:bg-brand-50 hover:shadow-sm">
                    <p class="font-heading text-sm font-semibold text-ink">{p.data.title}</p>
                    <p class="mt-1 text-xs leading-5 text-muted line-clamp-2">{p.data.summary}</p>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </aside>
    </div>

    <section class="bg-asphalt py-16 sm:py-20">
      <div class="mx-auto max-w-4xl px-5 text-center sm:px-6 lg:px-8">
        <h2 class="font-heading text-3xl font-bold text-white sm:text-4xl">Siap Memulai Proyek Anda?</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-neutral-300">Konsultasikan kebutuhan IT Anda secara gratis. Tim kami siap membantu mewujudkan solusi terbaik untuk bisnis Anda.</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href={waBottom} class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-8 py-4 font-heading text-base font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-md">
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Chat WhatsApp
          </a>
          <a href="/kontak" class="inline-flex items-center gap-2 rounded-lg border border-white/25 px-8 py-4 font-heading text-base font-semibold text-white transition-colors hover:border-white/60">Form Kontak</a>
        </div>
      </div>
    </section>

    <div class="pointer-events-none fixed inset-x-0 bottom-0 z-40 flex justify-center pb-6 lg:hidden">
      <a href={waBottom} class="pointer-events-auto inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3.5 font-heading text-sm font-semibold text-white shadow-lg transition-all hover:bg-brand-700 active:scale-95">
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Info via WA
      </a>
    </div>
  </main>
</BaseLayout>
