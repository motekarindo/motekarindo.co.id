---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import PortofolioCard from "@/components/PortofolioCard.astro";
import { byOrder } from "@/lib/content";

const portofolio = byOrder(await getCollection("portofolio")).filter((p) => p.data.is_published !== false);
const title = "Portofolio \u2014 Studi Kasus & Hasil Nyata | Motekar";
const description = "Studi kasus nyata dari project yang kami kerjakan \u2014 lengkap dengan masalah, solusi, teknologi, dan hasil terukur.";
---

<BaseLayout title={title} description={description}>
  <main>
    <PageHero eyebrow="Portofolio" title="Bukan sekadar janji — ini yang sudah kami kerjakan." description="Setiap project diceritakan dari awal sampai akhir: masalah, tindakan, teknologi, dan hasil terukur. Karena bukti lebih keras daripada kata-kata." />
    <section class="mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:px-8 lg:py-24">
      <div class="grid gap-6 lg:grid-cols-2">
        {portofolio.map((item) => (
          <PortofolioCard title={item.data.title} client={item.data.client} problem={item.data.problem} solution={item.data.solution} technologies={item.data.technologies} outcome={item.data.outcome} href={`/portofolio/${item.data.slug}`} />
        ))}
      </div>
    </section>
  </main>
</BaseLayout>
