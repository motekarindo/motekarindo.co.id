---
import BaseLayout from "@/layouts/BaseLayout.astro";

const title = "Halaman Tidak Ditemukan | Motekarindo";
const description = "Halaman yang Anda cari tidak ditemukan. Kembali ke beranda untuk melihat layanan kami.";
---

<BaseLayout title={title} description={description}>
  <main>
    <section class="bg-grid relative overflow-hidden border-b border-line">
      <div class="relative mx-auto max-w-7xl px-5 py-24 sm:px-6 lg:px-8 lg:py-32">
        <div class="mx-auto max-w-3xl text-center">
          <span class="inline-block eyebrow text-sm font-semibold uppercase tracking-[0.06em] text-brand-700">404</span>
          <h1 class="mt-6 font-heading text-4xl font-extrabold leading-tight text-ink sm:text-5xl lg:text-6xl">
            Halaman tidak ditemukan
          </h1>
          <p class="mt-6 text-lg leading-8 text-muted">
            Halaman yang Anda cari mungkin sudah dipindahkan, dihapus, atau tidak pernah ada.
          </p>
          <div class="mt-8 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
            <a href="/" class="inline-flex items-center gap-2 rounded-lg bg-brand-600 px-6 py-3.5 text-sm font-bold text-white transition-all hover:bg-brand-700 hover:shadow-lg hover:shadow-brand-600/40">
              <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/></svg>
              Kembali ke Beranda
            </a>
            <a href="/layanan" class="inline-flex items-center gap-2 rounded-lg border border-ink bg-white px-6 py-3.5 text-sm font-semibold text-brand-700 transition-all hover:bg-brand-50 hover:text-brand-600">
              Lihat Layanan Kami
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
