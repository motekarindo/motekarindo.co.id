---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { byOrder } from "@/lib/content";
import ServiceIllustration from "@/components/ServiceIllustration.astro";
import { site } from "@/lib/site.data";
import { cities } from "@/lib/cities";

export async function getStaticPaths() {
  const items = await getCollection("services");
  const localized = items.filter(
    (i) => i.data.is_localization && i.data.is_published !== false
  );

  const paths: { params: { service: string; city: string } }[] = [];
  for (const item of localized) {
    for (const c of cities) {
      paths.push({ params: { service: item.data.slug, city: c.slug } });
    }
  }
  return paths;
}

const { service, city } = Astro.params;
const cityData = cities.find((c) => c.slug === city);
const cityName = cityData?.name ?? city;

const allServices = byOrder(await getCollection("services"));
const item = allServices.find(
  (s) => s.data.slug === service && s.data.is_localization
);
if (!item) return Astro.redirect("/layanan");

const fm = item.data;
const fmTitle = fm.title;

const title = `${fmTitle} di ${cityName} | Motekar`;
const description = `Jasa ${fmTitle.toLowerCase()} profesional di ${cityName} dan sekitarnya. Gratis konsultasi awal, tanpa komitmen.`;

const related = allServices
  .filter((s) => s.data.is_published !== false && s.data.slug !== service)
  .slice(0, 3);

const whatsappBase = `https://wa.me/${site.whatsApp}?text=`;
const waHero = whatsappBase + encodeURIComponent(`Halo Motekarindo, saya butuh ${fmTitle.toLowerCase()} di ${cityName}`);
const waSidebar = whatsappBase + encodeURIComponent(`Halo Motekarindo, saya tertarik dengan ${fmTitle.toLowerCase()} di ${cityName}`);
const waBottom = whatsappBase + encodeURIComponent(`Halo Motekarindo, saya ingin konsultasi ${fmTitle.toLowerCase()} di ${cityName}`);
---

<BaseLayout title={title} description={description}>
  <main>
    <nav class="border-b border-line bg-white" aria-label="Breadcrumb">
      <ol class="mx-auto flex max-w-7xl items-center gap-1.5 px-5 py-3 text-sm text-soft sm:px-6 lg:px-8">
        <li><a href="/" class="transition-colors hover:text-brand-600">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/layanan" class="transition-colors hover:text-brand-600">Layanan</a></li>
        <li aria-hidden="true">/</li>
        <li><a href={`/layanan/${service}`} class="transition-colors hover:text-brand-600">{fmTitle}</a></li>
        <li aria-hidden="true">/</li>
        <li class="truncate text-ink" aria-current="page">{cityName}</li>
      </ol>
    </nav>

    <section class="relative overflow-hidden border-b-2 border-brand-200 bg-white">
      <div class="absolute inset-0 bg-dots opacity-40" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-7xl gap-10 px-5 py-5 sm:px-6 sm:py-22 lg:grid-cols-2 lg:items-center lg:px-8 lg:py-10">
        <div>
          <span class="inline-block rounded-full bg-brand-600 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-white shadow-sm">
            {fm.category ?? "Layanan"}
          </span>
          <h1 class="mt-6 font-heading text-4xl font-extrabold leading-tight text-ink sm:text-5xl lg:text-[3.25rem]">
            {fmTitle} di {cityName}
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-muted">
            Layanan {fmTitle.toLowerCase()} profesional di {cityName} dan sekitarnya — terukur, terdokumentasi, bisa dirawat. Konsultasi awal gratis.
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <a href={waHero} class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-6 py-3 font-heading text-base font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-md">
              <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Chat WhatsApp
            </a>
            <a href={`/layanan/${service}`} class="inline-flex items-center gap-2 rounded-full border-2 border-brand-200 px-6 py-3 font-heading text-base font-semibold text-brand-700 transition-all hover:border-brand-600 hover:bg-brand-50">
              Info Layanan
            </a>
          </div>
        </div>
        <div class="hidden lg:flex lg:items-center lg:justify-center">
          <div class="flex h-full w-full items-center justify-center bg-brand-50 p-12 rounded-2xl">
            <ServiceIllustration icon={fm.icon} class="max-h-64 w-full max-w-xs" />
          </div>
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 lg:grid lg:grid-cols-12 lg:gap-12 lg:px-8 lg:py-24">
      <div class="lg:col-span-8">
        <article class="prose prose-lg max-w-none
          prose-headings:font-heading prose-headings:font-bold prose-headings:text-ink prose-headings:scroll-mt-24
          prose-h3:mt-12 prose-h3:mb-4 prose-h3:text-xl prose-h3:sm:text-2xl prose-h3:text-brand-700
          prose-p:text-muted prose-p:leading-8 prose-li:text-muted prose-li:leading-7 prose-li:marker:text-brand-500
          prose-strong:text-ink prose-strong:font-semibold prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline
        ">
          <h2>{fmTitle} di {cityName} dan Sekitarnya</h2>

          <p>Membutuhkan <strong>{fmTitle.toLowerCase()}</strong> di <strong>{cityName}</strong>? Kami menyediakan layanan profesional dengan standar yang sama di setiap project: terukur, terdokumentasi, bisa dirawat.</p>

          <p>Kami melayani klien di {cityName} dan sekitarnya. Tim kami siap membantu — dari konsultasi awal hingga serah terima. Proses bisa dilakukan remote maupun onsite sesuai kebutuhan.</p>

          <h3>Mengapa Memilih Kami untuk {fmTitle} di {cityName}?</h3>
          <ul>
            <li><strong>Konsultasi awal gratis</strong> — ceritakan kebutuhan Anda, kami bantu arahkan solusi yang paling masuk akal.</li>
            <li><strong>Dokumentasi lengkap</strong> — setiap setup, konfigurasi, dan perubahan tercatat rapi.</li>
            <li><strong>Hasil terukur</strong> — setiap project memiliki tolok ukur yang diverifikasi sebelum serah terima.</li>
            <li><strong>Sistem bisa dirawat sendiri</strong> — setelah selesai, sistem jadi milik Anda, bukan ketergantungan.</li>
          </ul>

          <p>
            Ingin tahu lebih detail tentang layanan ini?
            <a href={`/layanan/${service}`}> Baca selengkapnya di halaman {fmTitle.toLowerCase()} &rarr;</a>
          </p>

          <h3>FAQ</h3>

          <p><strong>Apakah melayani {fmTitle.toLowerCase()} di {cityName}?</strong><br />
          Ya. Kami melayani klien di {cityName} dan sekitarnya. Proses konsultasi dan koordinasi bisa dilakukan secara remote, sementara pengerjaan bisa dilakukan onsite jika diperlukan.</p>

          <p><strong>Berapa biaya {fmTitle.toLowerCase()} di {cityName}?</strong><br />
          Biaya tergantung pada kompleksitas dan skala proyek. Sesi konsultasi awal gratis — setelah itu kami kirim proposal transparan dengan rincian biaya dan deliverable sebelum Anda commit.</p>

          <p><strong>Berapa lama proses pengerjaan di {cityName}?</strong><br />
          Tergantung pada jenis dan kompleksitas layanan. Estimasi detail akan diberikan setelah sesi konsultasi awal. Kami selalu berusaha memberikan timeline yang realistis dan transparan.</p>

          <p><strong>Apakah ada garansi untuk hasil pekerjaan?</strong><br />
          Ya. Setiap proyek disertai masa garansi untuk perbaikan bug terkait pekerjaan kami. Setelah itu, Anda bisa melanjutkan dengan paket maintenance bulanan jika diperlukan.</p>
        </article>

        {related.length > 0 && (
          <section class="mt-16 border-t-2 border-brand-100 pt-10">
            <h3 class="font-heading text-lg font-bold text-ink mb-5">Layanan lainnya</h3>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((s) => (
                <a href={`/layanan/${s.data.slug}`} class="group rounded-xl border-2 border-line bg-white p-5 transition-all hover:border-brand-400 hover:shadow-md hover:-translate-y-0.5">
                  <p class="font-heading text-sm font-bold text-ink group-hover:text-brand-600 transition-colors">{s.data.title}</p>
                  <p class="mt-1.5 text-xs leading-5 text-muted line-clamp-2">{s.data.summary}</p>
                  <span class="mt-3 inline-block text-xs font-semibold text-brand-600">Selengkapnya &rarr;</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="mt-16 lg:col-span-4 lg:mt-0">
        <div class="lg:sticky lg:top-28 space-y-8">
          <div class="rounded-2xl border-2 border-brand-200 bg-brand-50 p-6 shadow-sm">
            <h3 class="font-heading text-lg font-bold text-ink">Butuh {fmTitle} di {cityName}?</h3>
            <p class="mt-2 text-sm leading-6 text-muted">Diskusikan kebutuhan Anda dengan tim kami. Konsultasi awal gratis, tanpa komitmen.</p>
            <a href={waSidebar} class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand-600 px-5 py-3 text-center font-heading text-sm font-semibold text-white shadow-sm transition-all hover:bg-brand-700">
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Chat via WhatsApp
            </a>
          </div>
          {related.length > 0 && (
            <div>
              <h3 class="font-heading text-lg font-bold text-ink">Layanan terkait</h3>
              <div class="mt-4 space-y-3">
                {related.map((s) => (
                  <a href={`/layanan/${s.data.slug}`} class="block rounded-xl border border-line bg-white p-4 transition-all hover:border-brand-200 hover:bg-brand-50 hover:shadow-sm">
                    <p class="font-heading text-sm font-semibold text-ink">{s.data.title}</p>
                    <p class="mt-1 text-xs leading-5 text-muted line-clamp-2">{s.data.summary}</p>
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      </aside>
    </div>

    <section class="border-t-2 border-brand-100 bg-brand-50 py-16 sm:py-20">
      <div class="mx-auto max-w-4xl px-5 text-center sm:px-6 lg:px-8">
        <h2 class="font-heading text-3xl font-bold text-ink sm:text-4xl">Butuh {fmTitle} di {cityName}?</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-muted">Konsultasi awal gratis, tanpa komitmen. Ceritakan kebutuhan Anda — kami bantu tentukan langkah teknis yang paling masuk akal.</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href={waBottom} class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-8 py-4 font-heading text-base font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-md">
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Chat WhatsApp
          </a>
          <a href="/kontak" class="inline-flex items-center gap-2 rounded-full border-2 border-brand-200 px-8 py-4 font-heading text-base font-semibold text-brand-700 transition-all hover:border-brand-600 hover:bg-brand-50">Form Kontak</a>
        </div>
      </div>
    </section>

    <div class="pointer-events-none fixed inset-x-0 bottom-0 z-40 flex justify-center pb-6 lg:hidden">
      <a href={waBottom} class="pointer-events-auto inline-flex items-center gap-2 rounded-full bg-brand-600 px-6 py-3.5 font-heading text-sm font-semibold text-white shadow-lg transition-all hover:bg-brand-700 active:scale-95">
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Konsultasi via WA
      </a>
    </div>
  </main>
</BaseLayout>
