---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import SolutionCard from "@/components/SolutionCard.astro";
import { byOrder } from "@/lib/content";

const solutions = byOrder(await getCollection("solutions")).filter((p) => p.data.is_published !== false);
const title = "Solusi IT \u2014 Paket Layanan untuk Bisnis & Institusi | Motekarindo";
const description = "Solusi Motekarindo menggabungkan layanan IT untuk percetakan digital, institusi pendidikan, perusahaan, dan organisasi.";
---

<BaseLayout title={title} description={description}>
  <main>
    <PageHero eyebrow="Solusi" title="Solusi berdasarkan kebutuhan bisnis Anda" description="Gabungan layanan IT yang disesuaikan dengan konteks bisnis Anda — dari percetakan digital hingga institusi pendidikan." />
    <section class="mx-auto max-w-7xl px-5 py-20 sm:px-6 lg:px-8 lg:py-24">
        <div class="grid gap-8">
            {solutions.map((sol) => (<SolutionCard title={sol.data.title} eyebrow={sol.data.eyebrow} summary={sol.data.summary} services={sol.data.services} outcome={sol.data.outcome} href={`/solusi/${sol.id}`} />))}
        </div>
    </section>
  </main>
</BaseLayout>
