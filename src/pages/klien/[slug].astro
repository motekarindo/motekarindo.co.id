---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import { byOrder } from "@/lib/content";
import ServiceIllustration from "@/components/ServiceIllustration.astro";
import { site } from "@/lib/site.data";

export async function getStaticPaths() {
  const items = await getCollection("clients");
  return items
    .filter((i) => i.data.is_published !== false)
    .map((item) => ({ params: { slug: item.data.slug } }));
}

const { slug } = Astro.params;
const mdFiles = import.meta.glob("/src/content/klien/*.md");

let mod: any;
for (const [, loader] of Object.entries(mdFiles)) {
  const m = await loader();
  if (m.frontmatter.slug === slug) {
    mod = m;
    break;
  }
}

if (!mod) {
  return Astro.redirect("/klien", 302);
}

const Content = mod.Content;
const fm = mod.frontmatter;

if (fm.is_published === false) {
  return Astro.redirect("/klien", 302);
}

const allClients = byOrder(await getCollection("clients"));
const related = allClients.filter((c) => c.data.is_published !== false && c.data.slug !== slug).slice(0, 3);

const images = import.meta.glob<{ default: { src: string; width: number; height: number } }>(
  "/src/assets/images/klien/**/*.{jpg,jpeg,png,webp,avif}"
);
let heroImage: { src: string; width: number; height: number } | undefined;
if (fm.image?.file) {
  const match = Object.entries(images).find(([path]) => path.endsWith("/" + fm.image.file));
  if (match) {
    const resolved = await match[1]();
    heroImage = resolved.default;
  }
}
const heroAlt = fm.image?.alt ?? fm.name;

const logoImages = import.meta.glob<{ default: { src: string; width: number; height: number } }>(
  "/src/assets/images/klien/**/*.{jpg,jpeg,png,webp,avif}"
);
let logo: { src: string; width: number; height: number } | undefined;
if (fm.logo) {
  const logoMatch = Object.entries(logoImages).find(([p]) => p.endsWith("/" + fm.logo));
  if (logoMatch) {
    const resolved = await logoMatch[1]();
    logo = resolved.default;
  }
}

const whatsappBase = `https://wa.me/${site.whatsApp}?text=`;
const waHero = whatsappBase + encodeURIComponent("Halo Motekarindo, saya ingin konsultasi.");
const waSidebar = whatsappBase + encodeURIComponent("Halo Motekarindo, saya tertarik dengan layanan serupa dengan " + fm.name);
const waBottom = whatsappBase + encodeURIComponent("Halo Motekarindo, saya ingin konsultasi tentang layanan IT");
---

<BaseLayout
  title={`${fm.name} — Klien Motekarindo`}
  description={fm.description ?? ""}
>
  <main>
    <nav class="border-b border-line bg-white" aria-label="Breadcrumb">
      <ol class="mx-auto flex max-w-7xl items-center gap-1.5 px-5 py-3 text-sm text-soft sm:px-6 lg:px-8">
        <li><a href="/" class="transition-colors hover:text-brand-600">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/klien" class="transition-colors hover:text-brand-600">Klien</a></li>
        <li aria-hidden="true">/</li>
        <li class="truncate text-ink" aria-current="page">{fm.name}</li>
      </ol>
    </nav>

    <!-- Hero: 2 columns, image or illustration -->
    <section class="relative overflow-hidden border-b-2 border-brand-200 bg-white">
      <div class="absolute inset-0 bg-dots opacity-40" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-7xl gap-10 px-5 py-5 sm:px-6 sm:py-22 lg:grid-cols-2 lg:items-center lg:px-8 lg:py-10">
        <div>
          <div class="flex flex-wrap items-center gap-3 mb-4">
            <span class="inline-block rounded-full bg-brand-600 px-4 py-1.5 text-xs font-bold uppercase tracking-[0.14em] text-white shadow-sm">
              {fm.category ?? "Klien"}
            </span>
            <span class="inline-block rounded-full border border-brand-200 bg-brand-50 px-3 py-1 text-xs font-semibold text-brand-700">
              {fm.public ? "Publik" : "Disamarkan"}
            </span>
            {fm.location && (
              <span class="inline-flex items-center gap-1 text-xs text-soft">
                <svg class="size-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                {fm.location}
              </span>
            )}
          </div>
          <h1 class="font-heading text-4xl font-extrabold leading-tight text-ink sm:text-5xl lg:text-[3.25rem]">
            {fm.name}
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-8 text-muted">{fm.description}</p>
          <div class="relative mt-8 flex flex-wrap gap-4">
            <a href={waHero} target="_blank" class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-6 py-3 font-heading text-base font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-md">
              <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Chat WhatsApp
            </a>
            <a href={fm.website} target="_blank" class="inline-flex items-center gap-2 rounded-full border-2 border-brand-200 px-6 py-3 font-heading text-base font-semibold text-brand-700 transition-all hover:border-brand-600 hover:bg-brand-50">
                Website Klien
            </a>
          </div>
        </div>
        <div class="relative aspect-[4/3] overflow-hidden rounded-2xl shadow-xl lg:aspect-auto lg:h-full lg:min-h-[400px]">
          {heroImage ? (
            <img src={heroImage.src} width={heroImage.width} height={heroImage.height} alt={heroAlt} class="h-full w-full object-cover" loading="eager" />
          ) : logo ? (
            <div class="flex h-full w-full items-center justify-center bg-brand-50 p-12">
              <img src={logo.src} width={logo.width} height={logo.height} alt={`Logo ${fm.name}`} class="max-h-48 max-w-[80%] object-contain" />
            </div>
          ) : (
            <div class="flex h-full w-full items-center justify-center bg-brand-50 p-12">
              <ServiceIllustration icon={fm.icon ?? "klien"} class="max-h-64 w-full max-w-xs" />
            </div>
          )}
        </div>
      </div>
    </section>

    <div class="mx-auto max-w-7xl px-5 py-16 sm:px-6 lg:grid lg:grid-cols-12 lg:gap-12 lg:px-8 lg:py-24">
      <div class="lg:col-span-8">
        <article class="prose prose-lg max-w-none
          prose-headings:font-heading prose-headings:font-bold prose-headings:text-ink prose-headings:scroll-mt-24
          prose-h3:mt-12 prose-h3:mb-4 prose-h3:text-xl prose-h3:sm:text-2xl prose-h3:text-brand-700
          prose-p:text-muted prose-p:leading-8 prose-li:text-muted prose-li:leading-7 prose-li:marker:text-brand-500
          prose-strong:text-ink prose-strong:font-semibold prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline
        ">
          <Content />
        </article>

        {fm.testimonial && (
          <blockquote class="mt-5 rounded-2xl border-2 border-brand-200 bg-brand-50 p-8 relative">
            <svg class="absolute -top-4 -left-4 size-10 text-brand-200" fill="currentColor" viewBox="0 0 24 24"><path d="M4.583 17.321C3.553 16.227 3 15 3 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311C9.591 11.69 11 13.166 11 15c0 1.933-1.567 3.5-3.5 3.5-1.146 0-2.188-.547-2.917-1.179zm10 0C13.553 16.227 13 15 13 13.011c0-3.5 2.457-6.637 6.03-8.188l.893 1.378c-3.335 1.804-3.987 4.145-4.247 5.621.537-.278 1.24-.375 1.929-.311C19.591 11.69 21 13.166 21 15c0 1.933-1.567 3.5-3.5 3.5-1.146 0-2.188-.547-2.917-1.179z"/></svg>
            <p class="text-lg font-medium leading-8 text-ink italic">{fm.testimonial}</p>
            {fm.public && <footer class="mt-4 text-sm font-semibold text-brand-600">— {fm.name}</footer>}
          </blockquote>
        )}

        {related.length > 0 && (
          <section class="mt-16 border-t-2 border-brand-100 pt-10">
            <h3 class="font-heading text-lg font-bold text-ink mb-5">Sektor lainnya</h3>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {related.map((c) => (
                <a href={`/klien/${c.id}`} class="group rounded-xl border-2 border-line bg-white p-5 transition-all hover:border-brand-400 hover:shadow-md hover:-translate-y-0.5">
                  <p class="font-heading text-sm font-bold text-ink group-hover:text-brand-600 transition-colors">{c.data.name}</p>
                  <p class="mt-1.5 text-xs leading-5 text-muted line-clamp-2">{c.data.description}</p>
                  <span class="mt-3 inline-block text-xs font-semibold text-brand-600">Selengkapnya &rarr;</span>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>

      <aside class="mt-16 lg:col-span-4 lg:mt-0">
        <div class="lg:sticky lg:top-28 space-y-8">
          <div class="rounded-2xl border-2 border-brand-200 bg-brand-50 p-6 shadow-sm">
            <h3 class="font-heading text-lg font-bold text-ink">Butuh layanan serupa?</h3>
            <p class="mt-2 text-sm leading-6 text-muted">Kami melayani berbagai sektor — dari pendidikan hingga bisnis. Konsultasi awal gratis.</p>
            <a href={waSidebar} target="_blank" class="mt-4 inline-flex w-full items-center justify-center gap-2 rounded-full bg-brand-600 px-5 py-3 text-center font-heading text-sm font-semibold text-white shadow-sm transition-all hover:bg-brand-700">
              <svg class="size-4" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Chat via WhatsApp
            </a>
          </div>
        </div>
      </aside>
    </div>

    <section class="border-t-2 border-brand-100 bg-brand-50 py-16 sm:py-20">
      <div class="mx-auto max-w-4xl px-5 text-center sm:px-6 lg:px-8">
        <h2 class="font-heading text-3xl font-bold text-ink sm:text-4xl">Butuh Layanan IT untuk Sektor Anda?</h2>
        <p class="mx-auto mt-4 max-w-2xl text-lg leading-8 text-muted">Konsultasikan kebutuhan IT bisnis atau institusi Anda secara gratis dengan tim kami.</p>
        <div class="mt-8 flex flex-wrap items-center justify-center gap-4">
          <a href={waBottom} target="_blank" class="inline-flex items-center gap-2 rounded-full bg-brand-600 px-8 py-4 font-heading text-base font-semibold text-white shadow-sm transition-all hover:bg-brand-700 hover:shadow-md">
            <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
            Chat WhatsApp
          </a>
        </div>
      </div>
    </section>

    <div class="pointer-events-none fixed inset-x-0 bottom-0 z-40 flex justify-center pb-6 lg:hidden">
      <a href={waBottom} class="pointer-events-auto inline-flex items-center gap-2 rounded-full bg-brand-600 px-6 py-3.5 font-heading text-sm font-semibold text-white shadow-lg transition-all hover:bg-brand-700 active:scale-95">
        <svg class="size-5" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
        Konsultasi via WA
      </a>
    </div>
  </main>
</BaseLayout>
