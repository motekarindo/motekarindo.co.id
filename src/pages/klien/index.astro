---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { byOrder } from "@/lib/content";

const clients = byOrder(await getCollection("clients")).filter((p) => p.data.is_published !== false);
const title = "Klien \u2014 Dipercaya oleh Institusi & Bisnis | Motekarindo";
const description = "Klien dan sektor yang menjadi fokus layanan Motekar Teknologi Indonesia — dari pendidikan hingga percetakan digital.";

const logoImages = import.meta.glob<{ default: { src: string; width: number; height: number } }>(
  "/src/assets/images/klien/**/*.{jpg,jpeg,png,webp,avif}"
);
---

<BaseLayout title={title} description={description}>
  <main>
    <PageHero eyebrow="Klien" title="Institusi dan bisnis yang sudah merasakan hasilnya." description="Pemerintah daerah, kementerian, kampus, dan bisnis yang aplikasi, server, atau jurnalnya kami bangun dan rawat." />
    <section class="bg-white py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          {clients.map((client) => {
            const logo = client.data.public && client.data.logo
              ? Object.entries(logoImages).find(([p]) => p.endsWith("/" + client.data.logo))
              : undefined;
            return (
              <article class="group relative flex flex-col rounded-2xl border border-line bg-white p-7 transition-colors hover:border-brand-600">
                {logo && (
                  <div class="mb-5 flex h-14 items-center">
                    {(async () => { const m: any = await logo[1](); return <img src={m.default.src} alt="" class="h-12 w-auto object-contain" loading="lazy" />; })()}
                  </div>
                )}
                <p class="text-sm font-semibold text-soft">{client.data.category}{client.data.location && ` · ${client.data.location}`}</p>
                <h2 class="mt-1.5 font-heading text-xl font-bold text-ink group-hover:text-brand-700">
                  <a href={`/klien/${client.data.slug}`} class="after:absolute after:inset-0">{client.data.name}</a>
                </h2>
                <p class="mt-3 text-[15px] leading-7 text-muted">{client.data.description}</p>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
