---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";
import { byOrder } from "@/lib/content";

const clients = byOrder(await getCollection("clients")).filter((p) => p.data.is_published !== false);
const title = "Klien \u2014 Dipercaya oleh Institusi & Bisnis | Motekarindo";
const description = "Klien dan sektor yang menjadi fokus layanan Motekar Teknologi Indonesia — dari pendidikan hingga percetakan digital.";

const logoImages = import.meta.glob<{ default: { src: string; width: number; height: number } }>(
  "/src/assets/images/klien/*.{jpg,jpeg,png,webp,avif}"
);
---

<BaseLayout title={title} description={description}>
  <main>
    <PageHero eyebrow="Klien" title="Institusi dan bisnis yang sudah merasakan hasilnya." description="Setiap klien mendapat standar yang sama — terukur, terdokumentasi, bisa dirawat. Beberapa identitas disamarkan sesuai permintaan." />
    <section class="bg-white py-20 lg:py-24">
      <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
        <div class="grid gap-5 md:grid-cols-3">
          {clients.map((client) => {
            const logo = client.data.public && client.data.logo
              ? Object.entries(logoImages).find(([p]) => p.endsWith("/" + client.data.logo))
              : undefined;
            return (
              <article class="group rounded-xl border-2 border-brand-200 bg-white p-6 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:shadow-md hover:border-brand-500">
                <span class="inline-block rounded-full bg-brand-100 px-2.5 py-1 text-[11px] font-bold uppercase tracking-[0.1em] text-brand-700">{client.data.category}</span>
                <h2 class="mt-4 font-heading text-xl font-bold text-ink group-hover:text-brand-600 transition-colors"><a href={`/klien/${client.id}`} class="hover:underline">{client.data.name}</a></h2>
                <p class="mt-3 text-sm leading-7 text-muted">{client.data.description}</p>
                <div class="mt-4 flex items-center gap-3">
                  <p class="rounded-lg bg-brand-100 px-3 py-1.5 text-xs font-semibold text-brand-700">{client.data.public ? "✅ Publik" : "🔒 Disamarkan"}</p>
                  {client.data.location && (
                    <p class="text-xs text-soft flex items-center gap-1">
                      <svg class="size-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                      {client.data.location}
                    </p>
                  )}
                </div>
              </article>
            );
          })}
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
