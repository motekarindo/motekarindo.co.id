---
import BaseLayout from "@/layouts/BaseLayout.astro";
import PageHero from "@/components/PageHero.astro";

const title = "Konsultasi IT Gratis \u2014 Ceritakan Kebutuhan Teknis Anda | Motekar";
const description = "Konsultasi IT gratis \u2014 ceritakan kebutuhan website, aplikasi, DevOps, atau server Anda. Tim Motekar siap bantu arahkan solusinya.";
---

<BaseLayout title={title} description={description}>
  <main>
    <PageHero eyebrow="Kontak" title="Ceritakan kebutuhan teknis Anda" description="Sampaikan kebutuhan website, aplikasi, DevOps, QA, atau infrastruktur server yang ingin dibangun atau dikelola." />
    <section class="mx-auto grid max-w-7xl gap-6 px-5 py-20 sm:px-6 lg:grid-cols-[1fr_1fr] lg:px-8 lg:py-24">
      <article class="rounded-xl border-2 border-line bg-white p-8 shadow-sm">
        <div class="mb-6 grid size-12 place-items-center rounded-xl bg-brand-600 text-2xl text-white">📧</div>
        <h2 class="font-heading text-2xl font-extrabold text-ink">Kontak Langsung</h2>
        <p class="mt-3 text-sm leading-7 text-muted">Sampaikan kebutuhan via email. Tim merespons dalam 1×24 jam kerja.</p>
        <div class="mt-6 grid gap-3">
          <a href="mailto:hello@motekarindo.co.id" class="inline-flex items-center justify-center gap-2 rounded-lg bg-brand-600 px-5 py-3 text-sm font-semibold text-white shadow-md shadow-brand-600/30 transition-all hover:bg-brand-700 hover:shadow-lg">
            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            hello@motekarindo.co.id
          </a>
          <a href="https://wa.me/6281212656699" target="_blank" rel="noopener noreferrer" class="inline-flex items-center justify-center gap-2 rounded-lg border-2 border-brand-600 bg-white px-5 py-3 text-sm font-semibold text-brand-700 transition-all hover:bg-brand-50 hover:text-brand-600">
              <svg class="size-4" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
              Konsultasi Gratis Sekarang
          </a>
        </div>
      </article>

      <article class="rounded-xl border-2 border-brand-200 bg-brand-50 p-8 shadow-sm">
        <div class="mb-6 grid size-12 place-items-center rounded-xl bg-brand-600 text-2xl text-white">📋</div>
        <h2 class="font-heading text-2xl font-extrabold text-ink">Informasi yang Membantu</h2>
        <ul class="mt-5 grid gap-3 text-sm leading-7 text-muted">
          <li class="flex items-start gap-2.5">
            <svg class="mt-1.5 size-4 shrink-0 text-brand-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span><strong class="text-ink">Jenis:</strong> website, OJS, ePrints, server, troubleshooting.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="mt-1.5 size-4 shrink-0 text-brand-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span><strong class="text-ink">Kondisi:</strong> sudah ada sistem atau mulai dari nol.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="mt-1.5 size-4 shrink-0 text-brand-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span><strong class="text-ink">Target:</strong> kapan sistem perlu siap.</span>
          </li>
          <li class="flex items-start gap-2.5">
            <svg class="mt-1.5 size-4 shrink-0 text-brand-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span><strong class="text-ink">Kendala:</strong> error, downtime, migrasi, performa, fitur.</span>
          </li>
        </ul>
      </article>
    </section>
  </main>
</BaseLayout>
